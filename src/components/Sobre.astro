---
import { existsSync } from 'node:fs';
import site from '../data/site.json';
import Herramientas from './Herramientas.astro';
import { textosDe, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const t = textosDe(Astro.props.lang).sobre;

// La foto vive en public/media/yo.(jpg|jpeg|webp|png); si no existe queda un espacio con la inicial
const foto = ['jpg', 'jpeg', 'webp', 'png'].map((ext) => `/media/yo.${ext}`).find((r) => existsSync(`public${r}`));
---

<section class="seccion sobre" id="sobre-mi">
  <div class="foto">
    {
      foto ? (
        <img src={foto} alt={t.fotoAlt} width="900" height="1200" loading="lazy" decoding="async" />
      ) : (
        <span aria-hidden="true">{site.marca.charAt(0)}</span>
      )
    }
  </div>
  <div>
    <p class="etiqueta">{t.etiqueta}</p>
    <h2>{t.titulo.antes}{' '}<em>{t.titulo.destacado}</em>{t.titulo.despues && ` ${t.titulo.despues}`}</h2>
    {t.parrafos.map((p) => <p class="texto">{p}</p>)}

    <p class="etiqueta herramientas-titulo">{t.herramientas}</p>
    <Herramientas />

    <div class="acciones">
      <a class="boton boton-oscuro" href="#contacto">{t.cta}</a>
      <a class="enlace" href="#casos">{t.ctaSecundario}</a>
    </div>
  </div>
</section>

<style>
  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    border-top: 1px solid var(--linea);
  }

  .foto {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 4;
    border-radius: 28px;
    overflow: hidden;
    background: linear-gradient(160deg, var(--acento-suave), var(--acento));
    color: rgb(255 255 255 / 0.9);
    font-size: clamp(5rem, 14vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    transform: rotate(-2deg);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h2 {
    margin-bottom: 1rem;
  }

  .texto {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
  }

  .texto + .texto {
    margin-top: 1rem;
  }

  .herramientas-titulo {
    margin: 1.75rem 0 0.75rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
  }

  .enlace {
    padding: 0.5rem 0;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--linea);
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .foto:hover {
      transform: rotate(0deg);
    }

    .enlace:hover {
      text-decoration-color: var(--acento);
    }
  }

  /* En móvil la foto va arriba y el texto debajo */
  @media (max-width: 820px) {
    .sobre {
      grid-template-columns: 1fr;
    }

    .foto {
      width: 100%;
      max-width: 340px;
    }
  }
</style>
