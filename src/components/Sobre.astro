---
import site from '../data/site.json';
import Herramientas from './Herramientas.astro';
import Imagen from './Imagen.astro';
import { local } from '../lib/imagenes';
import { textosDe, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const textos = textosDe(Astro.props.lang);
const t = textos.sobre;

// La foto vive en src/media/yo.(jpg|jpeg|webp|png); si no existe queda un espacio con la inicial
const foto = ['jpg', 'jpeg', 'webp', 'png'].map((ext) => `/media/yo.${ext}`).find(local);
---

<section class="seccion sobre" id="sobre-mi">
  <div class="foto">
    {
      foto ? (
        <Imagen src={foto} alt={t.fotoAlt} anchos={[360, 540, 720]} sizes="(max-width: 720px) min(calc(100vw - 3rem), 280px), 352px" />
      ) : (
        <span aria-hidden="true">{site.marca.charAt(0)}</span>
      )
    }
    <i class="esquina"></i>
    <i class="esquina"></i>
    <i class="esquina"></i>
    <i class="esquina"></i>
  </div>
  <div>
    <p class="paso">{t.etiqueta}</p>
    <h2>{[t.titulo.antes, t.titulo.destacado, t.titulo.despues].filter(Boolean).join(' ')}</h2>
    {/* Dónde estoy y disponibilidad, separados por un cuadrito como las pestañas */}
    <p class="datos">
      <span>{t.ubicacion}</span>
      <i class="separador" aria-hidden="true"></i>
      <span class="disponible"><i class="punto" aria-hidden="true"></i>{textos.hero.estado}</span>
    </p>
    {t.parrafos.map((p) => <p class="texto">{p}</p>)}

    <p class="paso herramientas-titulo">{t.herramientas}</p>
    <Herramientas />

    <div class="acciones">
      <a class="boton boton-oscuro" href="#contacto">{t.cta}</a>
      <a class="enlace" href="#casos">{t.ctaSecundario}</a>
    </div>
  </div>
</section>

<style>
  /* Sobre mí compacto: foto chica en 4:5 y texto al lado, del mismo ancho que los casos */
  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    max-width: var(--contenido);
    margin-inline: auto;
  }

  /* Foto con las esquinas de selección, como todas las piezas reales */
  .foto {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    background: linear-gradient(160deg, var(--acento-suave), var(--acento));
    color: rgb(255 255 255 / 0.9);
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .foto :global(picture) {
    width: 100%;
    height: 100%;
  }

  .foto :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 4px;
    object-fit: cover;
  }

  .datos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-bottom: 0.9rem;
    color: var(--texto);
    font-size: 0.875rem;
  }

  .separador {
    width: 5px;
    height: 5px;
    background: var(--gris);
  }

  .disponible {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #1f9d55;
    box-shadow: 0 0 0 3px rgb(31 157 85 / 0.18);
  }

  .paso {
    color: var(--acento-texto);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  h2 {
    margin: 0.35rem 0 0.75rem;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .texto {
    max-width: 52ch;
    color: var(--gris);
    font-size: 1rem;
    line-height: 1.55;
  }

  .texto + .texto {
    margin-top: 0.75rem;
  }

  .herramientas-titulo {
    margin: 1.5rem 0 0.6rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
  }

  .enlace {
    padding: 0.5rem 0;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--linea);
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .enlace:hover {
      text-decoration-color: var(--acento);
    }
  }

  /* En móvil la foto va arriba y el texto debajo */
  @media (max-width: 720px) {
    .sobre {
      grid-template-columns: 1fr;
    }

    .foto {
      width: 100%;
      max-width: 280px;
    }
  }
</style>
