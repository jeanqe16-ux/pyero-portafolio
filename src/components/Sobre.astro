---
import { Image } from 'astro:assets';
import textos from '../data/textos.json';
import Herramientas from './Herramientas.astro';

const t = textos.sobre;

// La foto se toma de src/assets/foto-pyero.(jpg|jpeg|png|webp|avif); si no existe, queda el placeholder
const fotos = import.meta.glob<ImageMetadata>('../assets/foto-pyero.{jpg,jpeg,png,webp,avif}', {
  eager: true,
  import: 'default',
});
const foto = Object.values(fotos)[0];
---

<section class="seccion sobre" id="sobre-mi">
  <div class="foto">
    {foto ? <Image src={foto} alt={t.fotoAlt} width={720} /> : <span>{t.fotoPendiente}</span>}
  </div>
  <div>
    <p class="etiqueta">{t.etiqueta}</p>
    <h2>{t.titulo.antes}{' '}<em>{t.titulo.destacado}</em>{t.titulo.despues && ` ${t.titulo.despues}`}</h2>
    {t.parrafos.map((p) => <p class="texto">{p}</p>)}

    <dl class="datos">
      {
        t.datos.map((d) => (
          <div>
            <dt>{d.titulo}</dt>
            <dd>{d.valor}</dd>
          </div>
        ))
      }
    </dl>

    <p class="etiqueta herramientas-titulo">{t.herramientas}</p>
    <Herramientas />

    <div class="acciones">
      <a class="boton boton-oscuro" href="#contacto">{t.cta}</a>
      <a class="enlace" href="#proyectos">{t.ctaSecundario}</a>
    </div>
  </div>
</section>

<style>
  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    border-top: 1px solid var(--linea);
  }

  .foto {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    overflow: hidden;
    background: var(--superficie);
    color: var(--gris);
    font-size: 0.875rem;
    transform: rotate(-2deg);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h2 {
    margin-bottom: 1.5rem;
  }

  .texto + .texto {
    margin-top: 1rem;
  }

  .datos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea);
  }

  dt {
    font-size: 0.8125rem;
    color: var(--gris);
  }

  dd {
    margin: 0.2rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .herramientas-titulo {
    margin: 2rem 0 0.75rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }

  .enlace {
    padding: 0.5rem 0;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--linea);
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .foto:hover {
      transform: rotate(0deg);
    }

    .enlace:hover {
      text-decoration-color: var(--acento);
    }
  }

  /* En móvil la foto va arriba y el texto debajo */
  @media (max-width: 820px) {
    .sobre {
      grid-template-columns: 1fr;
    }

    .foto {
      width: 100%;
      max-width: 360px;
    }
  }

  @media (max-width: 560px) {
    .datos {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>
