---
import site from '../data/site.json';
import textos from '../data/textos.json';
import { proyectos } from '../data/proyectos.json';
import { creadores } from '../data/creadores.json';
import { enlaceWhatsapp } from '../lib/enlaces';

const t = textos.hero;

const reels = [
  ...proyectos.map((p) => ({ nombre: p.nombre, categoria: p.categoria, video: p.video, poster: p.poster })),
  ...creadores.map((c) => ({ nombre: c.handle, categoria: c.categoria, video: c.video, poster: c.poster })),
];

// Abanico: cada reel rota y baja según su distancia al centro
const centro = (reels.length - 1) / 2;
const abanico = (i: number) => `--r:${(i - centro) * 4}deg;--y:${Math.abs(i - centro) * 14}px`;
---

<section class="hero">
  <p class="estado"><i></i>{t.estado}</p>
  <h1>
    {t.titulo.a}{' '}<span class="junto"><span class="chip" aria-hidden="true"
      ><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg></span
    >{' '}<em>{t.titulo.b}</em></span><br />
    {t.titulo.c}{' '}<span class="junto"><span class="chip chip-claro" aria-hidden="true"
      ><svg viewBox="0 0 24 24"
        ><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" fill="currentColor"></path></svg
      ></span
    >{' '}<em>{t.titulo.d}</em></span>
  </h1>
  <p class="bajada">{t.bajada}</p>
  <div class="acciones">
    <a class="boton boton-oscuro" href={enlaceWhatsapp} target="_blank" rel="noopener noreferrer">{t.cta}</a>
    <a class="boton boton-claro" href="#servicios">{t.secundario}</a>
  </div>

  <div class="escenario" id="reels">
    <p class="bit" aria-hidden="true">{site.marca}{site.marcaSufijo}</p>
    <ul class="reels">
      {
        reels.map((r, i) => (
          <li class="reel" style={abanico(i)} tabindex="0">
            {r.video ? (
              <video src={r.video} poster={r.poster || undefined} muted loop playsinline preload="none" />
            ) : r.poster ? (
              <img src={r.poster} alt={r.nombre} loading="lazy" />
            ) : (
              <div class="reel-vacio">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                </svg>
                <span>{t.proximamente}</span>
              </div>
            )}
            <div class="reel-pie">
              <strong>{r.nombre}</strong>
              <span>{r.categoria}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Con mouse los reels se reproducen al pasar por encima; en táctil, al tocarlos
  const conMouse = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reels = [...document.querySelectorAll<HTMLElement>('.reel')];

  reels.forEach((reel) => {
    const video = reel.querySelector('video');
    if (!video) return;
    const reproducir = () => video.play().catch(() => {});
    const detener = () => video.pause();

    if (conMouse) {
      reel.addEventListener('pointerenter', reproducir);
      reel.addEventListener('pointerleave', detener);
    } else {
      reel.addEventListener('click', () => {
        const estabaPausado = video.paused;
        reels.forEach((otro) => otro.querySelector('video')?.pause());
        if (estabaPausado) reproducir();
      });
    }
    reel.addEventListener('focus', reproducir);
    reel.addEventListener('blur', detener);
  });
</script>

<style>
  .hero {
    padding: clamp(2.5rem, 6vw, 5rem) 1.5rem 0;
    text-align: center;
  }

  .estado {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--acento-texto);
  }

  .estado i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgb(34 197 94 / 0.18);
  }

  .junto {
    white-space: nowrap;
  }

  .chip {
    display: inline-grid;
    place-items: center;
    width: 1.25em;
    height: 0.82em;
    border-radius: 0.24em;
    background: var(--negro);
    color: #fff;
    vertical-align: 0.02em;
    box-shadow: 0 0.12em 0.3em -0.08em rgb(0 0 0 / 0.5);
    transform: rotate(-4deg);
  }

  .chip-claro {
    background: var(--acento);
    transform: rotate(4deg);
  }

  .chip svg {
    width: 0.5em;
    height: 0.5em;
  }

  .bajada {
    max-width: 58ch;
    margin: 1.5rem auto 0;
    color: var(--gris);
    font-size: 1.0625rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .escenario {
    position: relative;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(3rem, 8vw, 7rem) 0 clamp(4rem, 7vw, 6rem);
  }

  .bit {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    font-family: Silkscreen, monospace;
    font-size: clamp(2rem, 11vw, 10.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px #d4d4d4;
    user-select: none;
    pointer-events: none;
  }

  .reels {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .reel {
    position: relative;
    flex: none;
    width: clamp(150px, 17vw, 232px);
    aspect-ratio: 9 / 16;
    margin: 0 -0.6vw;
    border-radius: 22px;
    overflow: hidden;
    background: var(--negro);
    cursor: pointer;
    transform: translateY(var(--y)) rotate(var(--r));
    box-shadow: 0 30px 50px -28px rgb(0 0 0 / 0.55);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.45s ease,
      filter 0.45s ease,
      box-shadow 0.45s ease;
  }

  .reel video,
  .reel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reel:focus-visible {
    z-index: 5;
    outline-offset: 4px;
    border-radius: 22px;
  }

  .reel-vacio {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    height: 100%;
    color: rgb(255 255 255 / 0.7);
    font-size: 0.75rem;
    background: linear-gradient(160deg, #2a2a2a, #0a0a0a 70%);
  }

  .reel:nth-child(even) .reel-vacio {
    background: linear-gradient(160deg, var(--acento-suave), var(--acento) 45%, #7a3a00);
    color: #fff;
  }

  .reel-vacio svg {
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.6rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }

  .reel-pie {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.1rem;
    padding: 2.5rem 1rem 1rem;
    text-align: left;
    color: #fff;
    font-size: 0.6875rem;
    line-height: 1.3;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
    pointer-events: none;
  }

  .reel-pie strong {
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .reel-pie span {
    opacity: 0.8;
  }

  /* El reel activo crece y se endereza; los demás se quedan atrás */
  @media (hover: hover) and (pointer: fine) {
    .reel:hover {
      z-index: 5;
      transform: translateY(-12px) rotate(0deg) scale(1.14);
      box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.7);
    }

    .reels:has(.reel:hover) .reel:not(:hover) {
      opacity: 0.5;
      filter: saturate(0.5) blur(1px);
      transform: translateY(var(--y)) rotate(var(--r)) scale(0.93);
    }
  }

  /* En pantallas angostas los reels pasan a un carrusel deslizable */
  @media (max-width: 820px) {
    .reels {
      justify-content: flex-start;
      gap: 0.75rem;
      margin: 0 -1.5rem;
      padding: 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .reel {
      width: 58vw;
      max-width: 260px;
      margin: 0;
      scroll-snap-align: center;
      transform: none;
    }
  }
</style>
