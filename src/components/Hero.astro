---
import site from '../data/site.json';
import Imagen from './Imagen.astro';
import { enlaceWhatsapp, iconoTiktok } from '../lib/enlaces';
import { ANCHOS_HERO, SIZES_HERO } from '../lib/hero';
import { textosDe, type Idioma } from '../lib/i18n';
import { optimizar } from '../lib/imagenes';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = textosDe(lang).hero;
const { hero } = site;
---

<section class="hero">
  {/* Capas del fondo, de abajo hacia arriba: foto (LCP), video en loop, lienzo WebGL, cubierta de entrada y velo de contraste */}
  <div
    class="hero-media"
    data-video={hero.video}
    data-video-movil={hero.videoMovil}
    data-poster={await optimizar(hero.imagen, 1920)}
    data-profundidad={hero.profundidad}
  >
    <Imagen src={hero.imagen} alt="" anchos={ANCHOS_HERO} sizes={SIZES_HERO} loading="eager" fetchpriority="high" />
    <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
    <canvas aria-hidden="true"></canvas>
    <div class="cubierta"></div>
    <div class="velo"></div>
  </div>

  <div class="hero-texto">
    <p class="estado"><i></i>{t.estado}</p>
    <h1>
      {t.titulo.a}{' '}<span class="junto"><span class="chip chip-redes" aria-hidden="true"
        ><svg viewBox="0 0 24 24"><path d="M9.2 7.4v9.2l7.6-4.6z" fill="currentColor"></path></svg
        ><svg viewBox="0 0 24 24"><path d={iconoTiktok} fill="currentColor"></path></svg
        ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
          ><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="3.9"></circle><path d="M16.9 7.1h.01"></path></svg
        ><svg viewBox="0 0 24 24"
          ><path
            d="M13.6 21.5v-8h2.7l.4-3.2h-3.1V8.4c0-.9.3-1.6 1.6-1.6h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.5v3.2h2.8v8z"
            fill="currentColor"></path></svg
        ><svg viewBox="0 0 24 24"
          ><path
            d="M4.4 9.3h3.3V20H4.4zM6 4a1.9 1.9 0 1 1 0 3.8A1.9 1.9 0 0 1 6 4zm3.7 5.3h3.1v1.5c.5-.9 1.6-1.8 3.3-1.8 3.3 0 3.9 2.1 3.9 4.9V20h-3.3v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V20H9.7z"
            fill="currentColor"></path></svg
        ></span
      >{' '}<em>{t.titulo.b}</em></span>{t.titulo.b2 && ` ${t.titulo.b2}`}{' '}
      {t.titulo.c}{' '}<span class="junto"><span class="chip chip-claro" aria-hidden="true"
        ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"
          ><path class="estrella" d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" fill="currentColor" stroke="none"></path
          ><g class="flecha"
            ><path d="M12 20V5M6 11l6-6 6 6"></path><path class="estela" d="M6.5 17v4M17.5 17v4"></path></g
          ></svg
        ></span
      >{' '}<em>{t.titulo.d}</em></span>
    </h1>
    <p class="bajada">{t.bajada}</p>
    <div class="acciones">
      <a class="boton boton-acento" href={enlaceWhatsapp(lang)} target="_blank" rel="noopener noreferrer">{t.cta}</a>
      <a class="boton boton-vidrio" href="#casos">{t.secundario}</a>
    </div>
  </div>
</section>

<script>
  import '../scripts/hero';
</script>

<style>
  .hero {
    /* Color que tapa la foto antes del revelado; el lienzo WebGL usa el mismo */
    --cubierta: #fff3e0;
    /* Naranja algo más oscuro para las palabras del titular sobre el cielo claro */
    --acento-hero: #c2530a;
    position: relative;
    display: grid;
    min-height: max(100svh, 38rem);
    overflow: hidden;
    isolation: isolate;
    text-align: center;
  }

  :global([data-tema='oscuro']) .hero {
    --cubierta: #0e0e0e;
    --acento-hero: var(--acento);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--cubierta);
  }

  .hero-media :global(img),
  .hero-media video,
  .hero-media canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    /* El horizonte queda un poco por debajo del centro; scripts/hero.ts usa el mismo encuadre */
    object-position: 50% 55%;
  }

  /* El video aparece con un fundido cuando empieza a reproducirse */
  .hero-media video {
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .hero-media:global(.con-video) video {
    opacity: 1;
  }

  .hero-media canvas {
    opacity: 0;
  }

  .hero-media canvas:global(.visible) {
    opacity: 1;
  }

  /* Cubierta: solo existe mientras el revelado está por empezar (hay JS y no se pidió menos movimiento).
     Si el script no llega a quitarla, se va sola a los 3 s */
  .cubierta,
  .velo {
    position: absolute;
    inset: 0;
  }

  .cubierta {
    background: var(--cubierta);
    opacity: 0;
    pointer-events: none;
  }

  :global(html.animar:not(.hero-listo)) .cubierta {
    opacity: 1;
    animation: cubierta-fuera 0.5s ease 3s forwards;
  }

  @keyframes cubierta-fuera {
    to {
      opacity: 0;
    }
  }

  /* Velo: aclara el cielo detrás del texto y funde el borde inferior con la página */
  .velo {
    background:
      linear-gradient(to top, var(--fondo), transparent 16%),
      linear-gradient(to bottom, rgb(255 250 242 / 0.6), rgb(255 250 242 / 0.28) 45%, transparent 68%);
  }

  /* En oscuro la foto se oscurece entera para que el texto blanco contraste */
  :global([data-tema='oscuro']) .velo {
    background:
      linear-gradient(to top, var(--fondo), transparent 18%),
      linear-gradient(to bottom, rgb(14 14 14 / 0.78), rgb(14 14 14 / 0.56) 55%, rgb(14 14 14 / 0.42));
  }

  .hero-texto {
    /* El menú flota encima del hero: el texto empieza por debajo de él, sobre el cielo */
    padding: calc(var(--alto-nav) + clamp(1.5rem, 4.5svh, 3.5rem)) 1.5rem 4rem;
  }

  h1 {
    max-width: 20ch;
    margin-inline: auto;
    font-size: clamp(2rem, 4.8vw, 4rem);
  }

  h1 em {
    color: var(--acento-hero);
  }

  /* Etiqueta de disponibilidad en una píldora de vidrio */
  .estado {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.45);
    backdrop-filter: blur(10px);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--texto);
  }

  :global([data-tema='oscuro']) .estado {
    border-color: rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.1);
  }

  .estado i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgb(34 197 94 / 0.18);
  }

  .junto {
    white-space: nowrap;
  }

  .chip {
    display: inline-grid;
    place-items: center;
    width: 1.25em;
    height: 0.82em;
    border-radius: 0.24em;
    background: var(--negro);
    color: #fff;
    vertical-align: 0.02em;
    box-shadow: 0 0.12em 0.3em -0.08em rgb(0 0 0 / 0.5);
    transform: rotate(-4deg);
  }

  .chip-claro {
    background: var(--acento);
    transform: rotate(4deg);
  }

  .chip svg {
    width: 0.5em;
    height: 0.5em;
  }

  /* La estrella se vuelve una flecha que sube con una pequeña estela, se queda un momento y vuelve a ser estrella (ciclo de 3 s) */
  .chip-claro {
    overflow: hidden;
  }

  .estrella,
  .flecha {
    transform-box: fill-box;
    transform-origin: center;
  }

  .estrella {
    animation: estrella 3s ease-in-out infinite;
  }

  .flecha {
    opacity: 0;
    animation: flecha 3s ease-in-out infinite;
  }

  .estela {
    animation: estela 3s ease-out infinite;
  }

  @keyframes estrella {
    0%,
    22% {
      opacity: 1;
      transform: none;
    }
    34%,
    86% {
      opacity: 0;
      transform: scale(0.2) rotate(90deg);
    }
    97%,
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes flecha {
    0%,
    26% {
      opacity: 0;
      transform: translateY(75%);
    }
    42%,
    72% {
      opacity: 1;
      transform: none;
    }
    86%,
    100% {
      opacity: 0;
      transform: translateY(-95%);
    }
  }

  @keyframes estela {
    0%,
    26% {
      opacity: 0;
    }
    34% {
      opacity: 0.9;
    }
    52%,
    100% {
      opacity: 0;
    }
  }

  /* Sin movimiento queda la estrella fija */
  @media (prefers-reduced-motion: reduce) {
    .estrella,
    .flecha,
    .estela {
      animation: none;
    }
  }

  /* En oscuro el chip negro de TikTok se perdería contra el fondo: lleva un borde fino */
  :global([data-tema='oscuro']) .chip-redes {
    outline: 1px solid rgb(255 255 255 / 0.2);
  }

  /* Icono que recorre las redes: cada 2 s cambian el color, la forma del chip y el símbolo */
  .chip-redes {
    background: #ff0000;
    animation: redes-fondo 10s infinite;
  }

  .chip-redes svg {
    grid-area: 1 / 1;
    width: 0.56em;
    height: 0.56em;
    opacity: 0;
    transform: scale(0.4) rotate(-45deg);
    animation: redes-simbolo 10s infinite;
  }

  .chip-redes svg:nth-child(2) {
    animation-delay: 2s;
  }

  .chip-redes svg:nth-child(3) {
    animation-delay: 4s;
  }

  .chip-redes svg:nth-child(4) {
    animation-delay: 6s;
  }

  .chip-redes svg:nth-child(5) {
    animation-delay: 8s;
  }

  /* YouTube, TikTok, Instagram, Facebook y LinkedIn */
  @keyframes redes-fondo {
    0%,
    15% {
      background: #ff0000;
      border-radius: 0.24em;
    }
    20%,
    35% {
      background: #0a0a0a;
      border-radius: 0.32em;
    }
    40%,
    55% {
      background: #e1306c;
      border-radius: 0.28em;
    }
    60%,
    75% {
      background: #1877f2;
      border-radius: 0.41em;
    }
    80%,
    95% {
      background: #0a66c2;
      border-radius: 0.14em;
    }
    100% {
      background: #ff0000;
      border-radius: 0.24em;
    }
  }

  @keyframes redes-simbolo {
    0% {
      opacity: 0;
      transform: scale(0.4) rotate(-45deg);
    }
    5%,
    15% {
      opacity: 1;
      transform: none;
    }
    20%,
    100% {
      opacity: 0;
      transform: scale(1.6) rotate(35deg);
    }
  }

  /* Sin movimiento queda fijo el primero */
  @media (prefers-reduced-motion: reduce) {
    .chip-redes,
    .chip-redes svg {
      animation: none;
    }

    .chip-redes svg:first-child {
      opacity: 1;
      transform: none;
    }
  }

  .bajada {
    max-width: 58ch;
    margin: 1.5rem auto 0;
    /* Más oscuro que el gris habitual: va sobre la foto, no sobre el fondo de la página */
    color: color-mix(in srgb, var(--texto) 80%, transparent);
    font-size: 1.0625rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Botón secundario de vidrio */
  .boton-vidrio {
    border-color: rgb(255 255 255 / 0.7);
    background: rgb(255 255 255 / 0.35);
    backdrop-filter: blur(12px) saturate(1.4);
    color: var(--texto);
  }

  :global([data-tema='oscuro']) .boton-vidrio {
    border-color: rgb(255 255 255 / 0.28);
    background: rgb(255 255 255 / 0.12);
  }

  @media (hover: hover) and (pointer: fine) {
    .boton-vidrio:hover {
      background: rgb(255 255 255 / 0.6);
    }

    :global([data-tema='oscuro']) .boton-vidrio:hover {
      background: rgb(255 255 255 / 0.22);
    }
  }
</style>
