---
import site from '../data/site.json';
import Imagen from './Imagen.astro';
import { enlaceWhatsapp, iconoTiktok } from '../lib/enlaces';
import { textosDe, type Idioma } from '../lib/i18n';
import { ANCHOS_REEL, SIZES_REEL, reelsDe } from '../lib/reels';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = textosDe(lang).hero;

const reels = reelsDe(lang);

// Abanico: cada reel rota y baja según su distancia al centro
const centro = (reels.length - 1) / 2;
const abanico = (i: number) => `--r:${(i - centro) * 4}deg;--y:${Math.abs(i - centro) * 14}px`;
---

<section class="hero">
  <p class="estado"><i></i>{t.estado}</p>
  <h1>
    {t.titulo.a}{' '}<span class="junto"><span class="chip chip-redes" aria-hidden="true"
      ><svg viewBox="0 0 24 24"><path d="M9.2 7.4v9.2l7.6-4.6z" fill="currentColor"></path></svg
      ><svg viewBox="0 0 24 24"><path d={iconoTiktok} fill="currentColor"></path></svg
      ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
        ><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="3.9"></circle><path d="M16.9 7.1h.01"></path></svg
      ><svg viewBox="0 0 24 24"
        ><path
          d="M13.6 21.5v-8h2.7l.4-3.2h-3.1V8.4c0-.9.3-1.6 1.6-1.6h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.5v3.2h2.8v8z"
          fill="currentColor"></path></svg
      ><svg viewBox="0 0 24 24"
        ><path
          d="M4.4 9.3h3.3V20H4.4zM6 4a1.9 1.9 0 1 1 0 3.8A1.9 1.9 0 0 1 6 4zm3.7 5.3h3.1v1.5c.5-.9 1.6-1.8 3.3-1.8 3.3 0 3.9 2.1 3.9 4.9V20h-3.3v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V20H9.7z"
          fill="currentColor"></path></svg
      ></span
    >{' '}<em>{t.titulo.b}</em></span>{t.titulo.b2 && ` ${t.titulo.b2}`}{' '}
    {t.titulo.c}{' '}<span class="junto"><span class="chip chip-claro" aria-hidden="true"
      ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"
        ><path class="estrella" d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" fill="currentColor" stroke="none"></path
        ><g class="flecha"
          ><path d="M12 20V5M6 11l6-6 6 6"></path><path class="estela" d="M6.5 17v4M17.5 17v4"></path></g
        ></svg
      ></span
    >{' '}<em>{t.titulo.d}</em></span>
  </h1>
  <p class="bajada">{t.bajada}</p>
  <div class="acciones">
    <a class="boton boton-oscuro" href={enlaceWhatsapp(lang)} target="_blank" rel="noopener noreferrer">{t.cta}</a>
    <a class="boton boton-claro" href="#casos">{t.secundario}</a>
  </div>

  <div class="escenario" id="reels">
    <div class="bit pixel" aria-hidden="true">
      <canvas class="pixel-lienzo"></canvas>
      <p class="pixel-mascara">{site.marca}{site.marcaSufijo}</p>
      <p class="pixel-contorno">{site.marca}{site.marcaSufijo}</p>
    </div>
    <ul class="reels">
      {
        reels.map((r, i) => (
          <li class="reel" style={abanico(i)} tabindex="0">
            {/* La portada es una imagen con srcset; el video va encima y solo se descarga al reproducirse */}
            {r.poster && (
              <Imagen
                src={r.poster}
                alt=""
                anchos={ANCHOS_REEL}
                sizes={SIZES_REEL}
                loading={i < 2 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            )}
            {r.video && <video src={r.video} aria-label={r.nombre} muted loop playsinline preload="none" />}
            {!r.video && !r.poster && (
              <div class="reel-vacio">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                </svg>
                <span>{t.proximamente}</span>
              </div>
            )}
            <div class="reel-pie">
              <strong>{r.nombre}</strong>
              <span>{r.categoria}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Con mouse los reels se reproducen al pasar por encima; en táctil, al tocarlos
  document.addEventListener('astro:page-load', () => {
    const conMouse = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reels = [...document.querySelectorAll<HTMLElement>('.reel')];

    reels.forEach((reel) => {
      const video = reel.querySelector('video');
      if (!video) return;
      const reproducir = () => video.play().catch(() => {});
      const detener = () => video.pause();

      if (conMouse) {
        reel.addEventListener('pointerenter', reproducir);
        reel.addEventListener('pointerleave', detener);
      } else {
        reel.addEventListener('click', () => {
          const estabaPausado = video.paused;
          reels.forEach((otro) => otro.querySelector('video')?.pause());
          if (estabaPausado) reproducir();
        });
      }
      reel.addEventListener('focus', reproducir);
      reel.addEventListener('blur', detener);
    });
  });
</script>

<style>
  .hero {
    padding: clamp(2rem, 5vw, 4rem) 1.5rem 0;
    text-align: center;
  }

  h1 {
    max-width: 20ch;
    margin-inline: auto;
    font-size: clamp(2rem, 4.8vw, 4rem);
  }

  .estado {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--acento-texto);
  }

  .estado i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgb(34 197 94 / 0.18);
  }

  .junto {
    white-space: nowrap;
  }

  .chip {
    display: inline-grid;
    place-items: center;
    width: 1.25em;
    height: 0.82em;
    border-radius: 0.24em;
    background: var(--negro);
    color: #fff;
    vertical-align: 0.02em;
    box-shadow: 0 0.12em 0.3em -0.08em rgb(0 0 0 / 0.5);
    transform: rotate(-4deg);
  }

  .chip-claro {
    background: var(--acento);
    transform: rotate(4deg);
  }

  .chip svg {
    width: 0.5em;
    height: 0.5em;
  }

  /* La estrella se vuelve una flecha que sube con una pequeña estela, se queda un momento y vuelve a ser estrella (ciclo de 3 s) */
  .chip-claro {
    overflow: hidden;
  }

  .estrella,
  .flecha {
    transform-box: fill-box;
    transform-origin: center;
  }

  .estrella {
    animation: estrella 3s ease-in-out infinite;
  }

  .flecha {
    opacity: 0;
    animation: flecha 3s ease-in-out infinite;
  }

  .estela {
    animation: estela 3s ease-out infinite;
  }

  @keyframes estrella {
    0%,
    22% {
      opacity: 1;
      transform: none;
    }
    34%,
    86% {
      opacity: 0;
      transform: scale(0.2) rotate(90deg);
    }
    97%,
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes flecha {
    0%,
    26% {
      opacity: 0;
      transform: translateY(75%);
    }
    42%,
    72% {
      opacity: 1;
      transform: none;
    }
    86%,
    100% {
      opacity: 0;
      transform: translateY(-95%);
    }
  }

  @keyframes estela {
    0%,
    26% {
      opacity: 0;
    }
    34% {
      opacity: 0.9;
    }
    52%,
    100% {
      opacity: 0;
    }
  }

  /* Sin movimiento queda la estrella fija */
  @media (prefers-reduced-motion: reduce) {
    .estrella,
    .flecha,
    .estela {
      animation: none;
    }
  }

  /* En oscuro el chip negro de TikTok se perdería contra el fondo: lleva un borde fino */
  :global([data-tema='oscuro']) .chip-redes {
    outline: 1px solid rgb(255 255 255 / 0.2);
  }

  /* Icono que recorre las redes: cada 2 s cambian el color, la forma del chip y el símbolo */
  .chip-redes {
    background: #ff0000;
    animation: redes-fondo 10s infinite;
  }

  .chip-redes svg {
    grid-area: 1 / 1;
    width: 0.56em;
    height: 0.56em;
    opacity: 0;
    transform: scale(0.4) rotate(-45deg);
    animation: redes-simbolo 10s infinite;
  }

  .chip-redes svg:nth-child(2) {
    animation-delay: 2s;
  }

  .chip-redes svg:nth-child(3) {
    animation-delay: 4s;
  }

  .chip-redes svg:nth-child(4) {
    animation-delay: 6s;
  }

  .chip-redes svg:nth-child(5) {
    animation-delay: 8s;
  }

  /* YouTube, TikTok, Instagram, Facebook y LinkedIn */
  @keyframes redes-fondo {
    0%,
    15% {
      background: #ff0000;
      border-radius: 0.24em;
    }
    20%,
    35% {
      background: #0a0a0a;
      border-radius: 0.32em;
    }
    40%,
    55% {
      background: #e1306c;
      border-radius: 0.28em;
    }
    60%,
    75% {
      background: #1877f2;
      border-radius: 0.41em;
    }
    80%,
    95% {
      background: #0a66c2;
      border-radius: 0.14em;
    }
    100% {
      background: #ff0000;
      border-radius: 0.24em;
    }
  }

  @keyframes redes-simbolo {
    0% {
      opacity: 0;
      transform: scale(0.4) rotate(-45deg);
    }
    5%,
    15% {
      opacity: 1;
      transform: none;
    }
    20%,
    100% {
      opacity: 0;
      transform: scale(1.6) rotate(35deg);
    }
  }

  /* Sin movimiento queda fijo el primero */
  @media (prefers-reduced-motion: reduce) {
    .chip-redes,
    .chip-redes svg {
      animation: none;
    }

    .chip-redes svg:first-child {
      opacity: 1;
      transform: none;
    }
  }

  .bajada {
    max-width: 58ch;
    margin: 1.5rem auto 0;
    color: var(--gris);
    font-size: 1.0625rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .escenario {
    position: relative;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(3rem, 8vw, 7rem) 0 clamp(3rem, 5vw, 4rem);
  }

  /* Nombre en fuente bit; las capas .pixel (lienzo, máscara y contorno) están en global.css */
  .bit {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    display: block;
    font-family: Silkscreen, monospace;
    font-size: clamp(2rem, 11vw, 10.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    user-select: none;
    pointer-events: none;
  }

  .bit :global(.pixel-contorno) {
    color: transparent;
    -webkit-text-stroke: 1px var(--contorno);
  }

  .reels {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .reel {
    position: relative;
    flex: none;
    width: clamp(150px, 17vw, 232px);
    aspect-ratio: 9 / 16;
    margin: 0 -0.6vw;
    border-radius: 22px;
    overflow: hidden;
    background: var(--negro);
    cursor: pointer;
    transform: translateY(var(--y)) rotate(var(--r));
    box-shadow: 0 30px 50px -28px rgb(0 0 0 / 0.55);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.45s ease,
      filter 0.45s ease,
      box-shadow 0.45s ease;
  }

  .reel video,
  .reel :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reel:focus-visible {
    z-index: 5;
    outline-offset: 4px;
    border-radius: 22px;
  }

  .reel-vacio {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    height: 100%;
    color: rgb(255 255 255 / 0.7);
    font-size: 0.75rem;
    background: linear-gradient(160deg, #2a2a2a, #0a0a0a 70%);
  }

  .reel:nth-child(even) .reel-vacio {
    background: linear-gradient(160deg, var(--acento-suave), var(--acento) 45%, #7a3a00);
    color: #fff;
  }

  .reel-vacio svg {
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.6rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }

  .reel-pie {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.1rem;
    padding: 2.5rem 1rem 1rem;
    text-align: left;
    color: #fff;
    font-size: 0.6875rem;
    line-height: 1.3;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
    pointer-events: none;
  }

  .reel-pie strong {
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .reel-pie span {
    opacity: 0.8;
  }

  /* El reel activo crece y se endereza; los demás se quedan atrás */
  @media (hover: hover) and (pointer: fine) {
    .reel:hover {
      z-index: 5;
      transform: translateY(-12px) rotate(0deg) scale(1.14);
      box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.7);
    }

    .reels:has(.reel:hover) .reel:not(:hover) {
      opacity: 0.5;
      filter: saturate(0.5) blur(1px);
      transform: translateY(var(--y)) rotate(var(--r)) scale(0.93);
    }
  }

  /* En pantallas angostas los reels pasan a un carrusel deslizable */
  @media (max-width: 820px) {
    .reels {
      justify-content: flex-start;
      gap: 0.75rem;
      margin: 0 -1.5rem;
      padding: 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .reel {
      width: 58vw;
      max-width: 260px;
      margin: 0;
      scroll-snap-align: center;
      transform: none;
    }
  }
</style>
