---
import site from '../data/site.json';
import { servicios } from '../data/servicios.json';
import { posts } from '../data/diseno.json';
import { textosDe, tr, type Idioma } from '../lib/i18n';
import { optimizar } from '../lib/imagenes';
import { reelsDe } from '../lib/reels';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const textos = textosDe(lang);
const t = textos.hero;
const a = textos.apertura;

// Trabajo real para la fila: reels y posts intercalados, todos en el mismo formato 4:5
const deReels = reelsDe(lang).filter((r) => r.poster).map((r) => r.poster);
const dePosts = posts.map((p) => p.imagenes[0]);
const intercaladas = Array.from({ length: Math.max(deReels.length, dePosts.length) }, (_, i) => [deReels[i], dePosts[i]]).flat().filter(Boolean);
const pool = await Promise.all([...new Set(intercaladas)].map((src) => optimizar(src, 280)));
const VISIBLES = 7;
const fila = pool.slice(0, VISIBLES);
---

<section class="apertura" aria-labelledby="apertura-titulo">
  <div class="orbe" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="apertura-texto">
    <h1 id="apertura-titulo">
      <span>{t.titulo.a} {t.titulo.b}{t.titulo.b2 && ` ${t.titulo.b2}`}</span>
      <span>{t.titulo.c} {t.titulo.d}</span>
    </h1>
    <p class="bajada">{t.bajada}</p>

    {/* Caja tipo app de IA: muestra pedidos de ejemplo y, si el visitante escribe, abre WhatsApp con su pedido */}
    <form
      class="prompt"
      action={`https://wa.me/${site.whatsapp}`}
      method="get"
      target="_blank"
      data-numero={site.whatsapp}
      data-mensaje={a.mensaje}
      data-servicio={a.servicio}
      data-pedidos={JSON.stringify(a.pedidos)}
    >
      <label class="solo-lector" for="pedido">{a.etiquetaPrompt}</label>
      <div class="prompt-campo">
        <textarea id="pedido" name="text" rows="3" maxlength="280" placeholder={a.pedidos[0]}></textarea>
        <span class="ejemplo" aria-hidden="true"><span class="ejemplo-texto"></span><i class="caret"></i></span>
      </div>
      <div class="prompt-pie">
        {/* Controles de una app de IA: decorativos */}
        <span class="control" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
        </span>
        <span class="derecha">
          <span class="modelo" aria-hidden="true">
            {a.cursor}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 10 5 5 5-5"></path></svg>
          </span>
          <span class="control" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              ><rect x="9" y="3" width="6" height="12" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg
            >
          </span>
          <button type="submit" class="enviar" aria-label={a.enviar} title={a.enviar}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M9 7h8v8"></path>
            </svg>
          </button>
        </span>
      </div>

      {/* Cursor de ejemplo: escribe el pedido y lo envía; solo es decoración */}
      <div class="cursor-pyero" aria-hidden="true">
        <svg viewBox="0 0 16 16"><path d="M1.5 1.2 14 7.3l-5.6 1.5-2.4 5.4z"></path></svg>
        <span>{a.cursor}</span>
      </div>
    </form>

    <div class="servicios" role="group" aria-label={a.servicios}>
      {
        servicios.map((s) => (
          <button type="button" class="servicio" aria-pressed="false" data-valor={tr(s, 'titulo', lang)}>
            {tr(s, 'titulo', lang)}
          </button>
        ))
      }
    </div>
  </div>

  {/* Fila de trabajos con esquinas de marco seleccionado, separadas de la imagen; se cambian en cascada */}
  <div class="fila" role="img" aria-label={a.trabajos} data-pool={JSON.stringify(pool)}>
    {
      fila.map((src, i) => (
        <figure class="marco">
          <img src={src} alt="" loading={i < 5 ? 'eager' : 'lazy'} decoding="async" fetchpriority="low" />
          <i></i><i></i><i></i><i></i>
        </figure>
      ))
    }
  </div>
</section>

<script>
  // Hero: un cursor escribe pedidos de cliente en la caja, los "envía" y la fila de trabajos se renueva en cascada
  import { salto } from '../scripts/escena';

  const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let limpiar: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    limpiar?.();
    const seccion = document.querySelector<HTMLElement>('.apertura');
    const form = seccion?.querySelector<HTMLFormElement>('.prompt');
    const fila = seccion?.querySelector<HTMLElement>('.fila');
    if (!seccion || !form || !fila) return;

    const campo = form.querySelector('textarea')!;
    const ejemplo = form.querySelector<HTMLElement>('.ejemplo-texto')!;
    const cursor = form.querySelector<HTMLElement>('.cursor-pyero')!;
    const enviar = form.querySelector<HTMLElement>('.enviar')!;
    const chips = [...seccion.querySelectorAll<HTMLButtonElement>('.servicio')];
    const pedidos: string[] = JSON.parse(form.dataset.pedidos || '[]');
    const relojes: number[] = [];
    const esperar = (ms: number) => new Promise<void>((r) => relojes.push(window.setTimeout(r, ms)));
    let vivo = true;

    // Envío real: arma el mensaje con el pedido (o el ejemplo visible) y los servicios elegidos
    const alEnviar = (e: SubmitEvent) => {
      e.preventDefault();
      const pedido = campo.value.trim() || ejemplo.textContent || pedidos[0];
      const elegidos = chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.valor);
      const lineas = [form.dataset.mensaje, pedido, elegidos.length ? `${form.dataset.servicio}: ${elegidos.join(', ')}` : ''];
      window.open(`https://wa.me/${form.dataset.numero}?text=${encodeURIComponent(lineas.filter(Boolean).join('\n'))}`, '_blank', 'noopener');
    };
    form.addEventListener('submit', alEnviar);
    chips.forEach((c) => c.addEventListener('click', () => c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'))));

    // Mientras el visitante escribe, el ejemplo se oculta
    const actualizar = () => form.classList.toggle('con-texto', campo.value.length > 0 || document.activeElement === campo);
    campo.addEventListener('input', actualizar);
    campo.addEventListener('focus', actualizar);
    campo.addEventListener('blur', actualizar);

    // Fila: cada tarjeta pasa a la siguiente pieza, de izquierda a derecha, con corte seco y un saltito
    const pool: string[] = JSON.parse(fila.dataset.pool || '[]');
    const marcos = [...fila.querySelectorAll<HTMLElement>('.marco')];
    let siguiente = marcos.length;
    const renovar = () => {
      marcos.forEach((marco, i) => {
        const src = pool[siguiente++ % pool.length];
        new Image().src = src;
        relojes.push(
          window.setTimeout(() => {
            marco.classList.add('vacio');
            relojes.push(
              window.setTimeout(() => {
                marco.querySelector('img')!.src = src;
                marco.classList.remove('vacio');
                salto(marco.querySelector('img')!);
              }, 130),
            );
          }, i * 95),
        );
      });
    };

    // Lleva el cursor justo encima del botón de enviar, sea cual sea el tamaño de pantalla
    const alBoton = () => {
      const c = cursor.getBoundingClientRect();
      const b = enviar.getBoundingClientRect();
      cursor.style.translate = `${b.left + b.width * 0.55 - c.left}px ${b.top + b.height * 0.55 - c.top}px`;
    };

    const escribir = async (texto: string) => {
      for (let i = 1; i <= texto.length && vivo; i++) {
        ejemplo.textContent = texto.slice(0, i);
        await esperar(38 + Math.random() * 55);
      }
    };
    const borrar = async () => {
      while (ejemplo.textContent && vivo) {
        ejemplo.textContent = ejemplo.textContent.slice(0, -2);
        await esperar(18);
      }
    };

    const ciclo = async () => {
      for (let n = 0; vivo; n = (n + 1) % pedidos.length) {
        await escribir(pedidos[n]);
        await esperar(500);
        if (!vivo) return;
        alBoton();
        await esperar(750);
        cursor.classList.add('clic');
        enviar.classList.add('pulsado');
        form.classList.add('enviado');
        renovar();
        await esperar(220);
        cursor.classList.remove('clic');
        enviar.classList.remove('pulsado');
        await esperar(1300);
        cursor.style.translate = '';
        form.classList.remove('enviado');
        await esperar(500);
        await borrar();
        await esperar(350);
      }
    };

    if (reducir) {
      ejemplo.textContent = pedidos[0];
      limpiar = () => form.removeEventListener('submit', alEnviar);
      return;
    }
    // Solo corre mientras el hero está en pantalla
    let corriendo = false;
    const vista = new IntersectionObserver(([entrada]) => {
      if (entrada.isIntersecting && !corriendo) {
        corriendo = true;
        vivo = true;
        ciclo();
      } else if (!entrada.isIntersecting && corriendo) {
        corriendo = false;
        vivo = false;
      }
    });
    vista.observe(form);
    limpiar = () => {
      vivo = false;
      vista.disconnect();
      relojes.forEach(clearTimeout);
      form.removeEventListener('submit', alEnviar);
    };
  });
</script>

<style>
  .apertura {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    min-height: max(100svh, 44rem);
    padding-top: calc(var(--alto-nav) + clamp(1.25rem, 5svh, 3.5rem));
    overflow: hidden;
    isolation: isolate;
    text-align: center;
  }

  /* Orbe: tres manchas de color muy desenfocadas detrás de la caja, que respiran despacio */
  .orbe {
    position: absolute;
    left: 50%;
    top: 46%;
    z-index: -1;
    width: min(62rem, 120vw);
    aspect-ratio: 2 / 1;
    translate: -50% -50%;
    filter: blur(70px);
    opacity: 0.75;
    pointer-events: none;
  }

  .orbe i {
    position: absolute;
    border-radius: 50%;
    animation: orbe 18s ease-in-out infinite alternate;
  }

  .orbe i:nth-child(1) {
    inset: 18% 46% 22% 14%;
    background: var(--orbe-durazno);
  }

  .orbe i:nth-child(2) {
    inset: 26% 18% 16% 44%;
    background: var(--orbe-lila);
    animation-delay: -6s;
  }

  .orbe i:nth-child(3) {
    inset: 40% 38% 20% 36%;
    background: var(--acento);
    opacity: 0.55;
    animation-delay: -11s;
  }

  @keyframes orbe {
    to {
      transform: translate(6%, -8%) scale(1.12);
    }
  }

  .apertura-texto {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: 1.5rem;
  }

  h1 {
    font-size: clamp(1.65rem, 3.1vw, 2.65rem);
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  h1 span {
    display: block;
  }

  .bajada {
    max-width: 44ch;
    margin-top: 0.9rem;
    color: var(--gris);
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    line-height: 1.5;
  }

  /* Caja tipo app de IA: la pieza protagonista del hero */
  .prompt {
    position: relative;
    width: min(42rem, 100%);
    margin-top: clamp(1.5rem, 4svh, 2.25rem);
    padding: 1.2rem 1rem 0.85rem 1.35rem;
    border: 1px solid var(--linea);
    border-radius: 22px;
    background: var(--superficie);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.8) inset,
      0 28px 60px -34px rgb(60 40 20 / 0.55);
    text-align: left;
    transition: box-shadow 0.4s ease;
  }

  .prompt.enviado {
    box-shadow:
      0 28px 60px -34px rgb(60 40 20 / 0.55),
      0 0 0 4px rgb(251 142 31 / 0.2);
  }

  .prompt-campo {
    position: relative;
  }

  textarea {
    display: block;
    width: 100%;
    min-height: 4.6rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--texto);
    font: inherit;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.5;
    resize: none;
    outline: none;
  }

  /* El placeholder real queda oculto: lo reemplaza el ejemplo que se escribe solo */
  textarea::placeholder {
    color: transparent;
  }

  .ejemplo {
    position: absolute;
    inset: 0;
    color: var(--gris);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.5;
    pointer-events: none;
  }

  .con-texto .ejemplo {
    visibility: hidden;
  }

  .caret {
    display: inline-block;
    width: 1.5px;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: -0.15em;
    background: var(--texto);
    animation: caret 1s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  .prompt-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.4rem;
  }

  .derecha {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .control {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    color: var(--gris);
  }

  .control svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .modelo {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0 0.4rem;
    color: var(--texto);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .modelo svg {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--gris);
  }

  .enviar {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 0;
    border-radius: 11px;
    background: var(--acento);
    color: var(--negro);
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .enviar svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .enviar.pulsado {
    transform: scale(0.88);
  }

  /* El cursor descansa fuera de la caja y viaja al botón de enviar */
  .prompt .cursor-pyero {
    top: auto;
    left: auto;
    right: -4rem;
    bottom: -2.75rem;
    transition: translate 0.75s cubic-bezier(0.65, 0, 0.25, 1);
  }

  /* Servicios: opciones debajo de la caja */
  .servicios {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .servicio {
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--linea);
    border-radius: 10px;
    background: color-mix(in srgb, var(--superficie) 70%, transparent);
    color: var(--texto);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .servicio[aria-pressed='true'] {
    border-color: var(--texto);
    background: var(--texto);
    color: var(--superficie);
  }

  /* Fila de trabajos: tarjetas iguales en 4:5, centradas, sin ocupar todo el ancho */
  .fila {
    --ancho-tarjeta: clamp(76px, 9.5vw, 124px);
    display: flex;
    justify-content: center;
    gap: clamp(18px, 2.2vw, 30px);
    margin-top: clamp(2rem, 5svh, 3.25rem);
    padding: 12px 1.5rem clamp(1.75rem, 4svh, 2.75rem);
  }

  .marco {
    position: relative;
    flex: none;
    width: var(--ancho-tarjeta);
    aspect-ratio: 4 / 5;
    margin: 0;
  }

  .marco img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 6px;
    object-fit: cover;
    background: var(--superficie);
  }

  /* Esquinas de marco seleccionado, separadas de la imagen */
  .marco i {
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--texto);
  }

  .marco i:nth-of-type(1) {
    top: -10px;
    left: -10px;
  }

  .marco i:nth-of-type(2) {
    top: -10px;
    right: -10px;
  }

  .marco i:nth-of-type(3) {
    bottom: -10px;
    left: -10px;
  }

  .marco i:nth-of-type(4) {
    bottom: -10px;
    right: -10px;
  }

  /* Corte seco: la tarjeta queda vacía un instante */
  .marco.vacio img {
    visibility: hidden;
  }

  .solo-lector {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .servicio[aria-pressed='false']:hover {
      border-color: var(--texto);
    }

    .enviar:hover {
      background: var(--texto);
      color: var(--superficie);
    }
  }

  @media (max-width: 900px) {
    .marco:nth-child(n + 6) {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .marco:nth-child(n + 5) {
      display: none;
    }

    .fila {
      --ancho-tarjeta: 64px;
      gap: 20px;
    }

    .prompt .cursor-pyero {
      right: -0.5rem;
      bottom: -2.5rem;
    }

    .modelo {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbe i,
    .caret {
      animation: none;
    }

    .prompt .cursor-pyero {
      display: none;
    }
  }
</style>
