---
import { casos } from '../data/casos.json';
import { clientes } from '../data/clientes.json';
import { creadores } from '../data/creadores.json';
import { posts } from '../data/diseno.json';
import { textosDe, type Idioma } from '../lib/i18n';
import { optimizar } from '../lib/imagenes';

interface Props {
  lang: Idioma;
}

const t = textosDe(Astro.props.lang).trabajos;
const nombreDe = (id: string) => clientes.find((c) => c.id === id)?.nombre ?? id;

// Todas las piezas en tarjetas iguales (4:5). Los videos de casos son "video" (o "motion" si su título lo dice),
// los reels de creadores son "motion" y los posts son "diseno"
const piezas = await Promise.all([
  ...casos.flatMap((c) =>
    c.videos.map(async (v) => ({
      tipo: /motion/i.test(v.titulo) ? 'motion' : 'video',
      nombre: `${nombreDe(c.cliente)}: ${v.titulo}`,
      mini: await optimizar(v.poster, 360),
      grande: await optimizar(v.poster, 720),
      video: v.video,
    })),
  ),
  ...creadores.map(async (c) => ({ tipo: 'motion', nombre: c.handle, mini: await optimizar(c.poster, 360), grande: await optimizar(c.poster, 720), video: c.video })),
  ...posts.map(async (p) => ({
    tipo: 'diseno',
    nombre: `${nombreDe(p.cliente)}: ${p.titulo}`,
    mini: await optimizar(p.imagenes[0], 360),
    grande: await optimizar(p.imagenes[0], 1000),
    video: '',
  })),
]);
// Intercala los tipos para que "Todo" se vea variado
const porTipo = ['video', 'motion', 'diseno'].map((tipo) => piezas.filter((p) => p.tipo === tipo));
const orden = Array.from({ length: Math.max(...porTipo.map((l) => l.length)) }, (_, i) => porTipo.map((l) => l[i])).flat().filter(Boolean);
const pestanas = Object.entries(t.pestanas) as [string, string][];
---

<section class="seccion trabajos" id="trabajos" aria-labelledby="trabajos-titulo">
  <header class="cabecera-chica">
    <p class="paso">{t.etiqueta}</p>
    <h2 id="trabajos-titulo">{t.titulo}</h2>
  </header>

  <div class="pestanas" role="group" aria-label={t.filtros}>
    {
      pestanas.map(([clave, texto], i) => (
        <button type="button" class="pestana" data-filtro={clave} aria-pressed={i === 0 ? 'true' : 'false'}>
          {texto}
        </button>
      ))
    }
  </div>

  <ul class="rejilla">
    {
      orden.map((p) => (
        <li class="tarjeta" data-tipo={p.tipo}>
          <button type="button" data-grande={p.grande} data-video={p.video} aria-label={p.nombre}>
            <img src={p.mini} alt="" loading="lazy" decoding="async" />
            {p.video && (
              <span class="reproducir" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
                </svg>
              </span>
            )}
          </button>
        </li>
      ))
    }
  </ul>

  {/* Visor: muestra la pieza en grande, el video con sus controles y sonido */}
  <dialog class="visor-trabajo" aria-label={t.etiqueta}>
    <button type="button" class="cerrar" aria-label={t.cerrar} title={t.cerrar}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
    <video controls playsinline preload="none" hidden></video>
    <img alt="" hidden />
  </dialog>
</section>

<script>
  // Pestañas que reordenan la rejilla en cascada con saltito, y un visor para ver cada pieza
  import { salto } from '../scripts/escena';

  document.addEventListener('astro:page-load', () => {
    const seccion = document.querySelector<HTMLElement>('.trabajos');
    if (!seccion) return;
    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pestanas = [...seccion.querySelectorAll<HTMLButtonElement>('.pestana')];
    const tarjetas = [...seccion.querySelectorAll<HTMLElement>('.tarjeta')];
    let relojes: number[] = [];

    const filtrar = (filtro: string) => {
      relojes.forEach(clearTimeout);
      relojes = [];
      pestanas.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === filtro)));
      const visibles = tarjetas.filter((c) => filtro === 'todo' || c.dataset.tipo === filtro);
      tarjetas.forEach((c) => (c.hidden = !visibles.includes(c)));
      if (reducir) return;
      // Cada tarjeta aparece un instante después que la anterior, con corte seco
      visibles.forEach((c, i) => {
        c.classList.add('oculta');
        relojes.push(
          window.setTimeout(() => {
            c.classList.remove('oculta');
            salto(c);
          }, 60 + i * 55),
        );
      });
    };
    pestanas.forEach((b) => b.addEventListener('click', () => filtrar(b.dataset.filtro!)));

    // Visor
    const visor = seccion.querySelector<HTMLDialogElement>('.visor-trabajo')!;
    const video = visor.querySelector('video')!;
    const imagen = visor.querySelector('img')!;
    seccion.querySelectorAll<HTMLButtonElement>('.tarjeta button').forEach((boton) =>
      boton.addEventListener('click', () => {
        const { video: src, grande } = boton.dataset;
        video.hidden = !src;
        imagen.hidden = !!src;
        if (src) {
          video.poster = grande!;
          video.src = src;
          video.play().catch(() => {});
        } else {
          imagen.src = grande!;
          imagen.alt = boton.getAttribute('aria-label') ?? '';
        }
        visor.showModal();
      }),
    );
    const cerrar = () => visor.close();
    visor.querySelector('.cerrar')!.addEventListener('click', cerrar);
    visor.addEventListener('click', (e) => e.target === visor && cerrar());
    visor.addEventListener('close', () => {
      video.pause();
      video.removeAttribute('src');
      video.load();
    });
  });
</script>

<style>
  .trabajos {
    text-align: center;
  }

  .pestanas {
    display: inline-flex;
    gap: 0.25rem;
    margin-top: 1.5rem;
    padding: 0.25rem;
    border: 1px solid var(--linea);
    border-radius: 12px;
    background: var(--superficie);
  }

  .pestana {
    padding: 0.4rem 0.9rem;
    border: 0;
    border-radius: 9px;
    background: none;
    color: var(--gris);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
  }

  .pestana[aria-pressed='true'] {
    background: var(--texto);
    color: var(--superficie);
  }

  .pestana:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 2px;
  }

  /* Rejilla de tarjetas iguales, con espacio para las esquinas de marco */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(9.5rem, 40%), 1fr));
    gap: 1.75rem;
    max-width: 58rem;
    margin: 2rem auto 0;
    padding: 0;
    list-style: none;
  }

  .tarjeta {
    position: relative;
  }

  .tarjeta.oculta {
    visibility: hidden;
  }

  .tarjeta button {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 8px;
    background: var(--superficie);
    cursor: pointer;
  }

  .tarjeta button:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 4px;
  }

  .tarjeta img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reproducir {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: var(--negro);
  }

  .reproducir svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  /* Esquinas de marco al pasar el mouse, separadas de la imagen */
  .tarjeta::before,
  .tarjeta::after {
    content: '';
    position: absolute;
    inset: -9px;
    background:
      linear-gradient(var(--texto), var(--texto)) top left / 6px 6px no-repeat,
      linear-gradient(var(--texto), var(--texto)) top right / 6px 6px no-repeat,
      linear-gradient(var(--texto), var(--texto)) bottom left / 6px 6px no-repeat,
      linear-gradient(var(--texto), var(--texto)) bottom right / 6px 6px no-repeat;
    opacity: 0;
    pointer-events: none;
  }

  .tarjeta::after {
    display: none;
  }

  .visor-trabajo {
    max-width: min(92vw, 30rem);
    max-height: 92svh;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 14px;
    background: var(--negro);
  }

  .visor-trabajo::backdrop {
    background: rgb(20 15 10 / 0.6);
    backdrop-filter: blur(6px);
  }

  .visor-trabajo video,
  .visor-trabajo img {
    display: block;
    width: 100%;
    max-height: 88svh;
    border-radius: 14px;
    object-fit: contain;
  }

  .visor-trabajo video {
    aspect-ratio: 9 / 16;
  }

  .visor-trabajo [hidden] {
    display: none;
  }

  .cerrar {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--superficie);
    color: var(--texto);
    cursor: pointer;
  }

  .cerrar svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .tarjeta:hover::before {
      opacity: 1;
    }

    .pestana[aria-pressed='false']:hover {
      color: var(--texto);
    }
  }

  @media (max-width: 560px) {
    .rejilla {
      gap: 1.25rem;
    }
  }
</style>
