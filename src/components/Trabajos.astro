---
import { casos } from '../data/casos.json';
import { clientes } from '../data/clientes.json';
import { creadores } from '../data/creadores.json';
import { posts, portadas } from '../data/diseno.json';
import { textosDe, type Idioma } from '../lib/i18n';
import { optimizar } from '../lib/imagenes';
import { svgIcono, type Icono } from '../lib/iconos';

interface Props {
  lang: Idioma;
}

const t = textosDe(Astro.props.lang).trabajos;
const nombreDe = (id: string) => clientes.find((c) => c.id === id)?.nombre ?? id;
const POR_FILA = 4;

type Pieza = { nombre: string; poster: string; video: string };
const videos = casos.flatMap((c) => c.videos.map((v) => ({ nombre: `${nombreDe(c.cliente)}: ${v.titulo}`, poster: v.poster, video: v.video })));
const esMotion = (p: Pieza) => /motion/i.test(p.nombre);

// Filas de cuatro, sin mezclar: una de edición, una de motion y una por cliente con sus diseños.
// Si a un cliente le faltan posts, se completa con sus portadas.
const disenoDe = (id: string): Pieza[] => [
  ...posts.filter((p) => p.cliente === id).flatMap((p) => p.imagenes.map((imagen) => ({ nombre: `${nombreDe(id)}: ${p.titulo}`, poster: imagen, video: '' }))),
  ...portadas.filter((p) => p.cliente === id).map((p) => ({ nombre: `${nombreDe(id)}: ${p.titulo}`, poster: p.imagen, video: '' })),
];
const grupos: { tipo: 'video' | 'motion' | 'diseno'; titulo: string; detalle: string; icono: Icono; color: string; piezas: Pieza[] }[] = [
  { tipo: 'video', titulo: t.grupos.video, detalle: t.reels, icono: 'video', color: '', piezas: videos.filter((v) => !esMotion(v)) },
  {
    tipo: 'motion',
    titulo: t.grupos.motion,
    detalle: t.reels,
    icono: 'motion',
    color: 'lila',
    piezas: [...videos.filter(esMotion), ...creadores.map((c) => ({ nombre: c.handle, poster: c.poster, video: c.video }))],
  },
  ...clientes
    .map((c) => ({ tipo: 'diseno' as const, titulo: c.nombre, detalle: t.grupos.diseno, icono: 'diseno' as Icono, color: 'oscuro', piezas: disenoDe(c.id) }))
    .filter((g) => g.piezas.length >= POR_FILA),
];
const filas = await Promise.all(
  grupos.map(async (g) => ({
    ...g,
    piezas: await Promise.all(
      g.piezas.slice(0, POR_FILA).map(async (p) => ({ ...p, mini: await optimizar(p.poster, 360), grande: await optimizar(p.poster, p.video ? 720 : 1000) })),
    ),
  })),
);
const pestanas = Object.entries(t.pestanas) as [string, string][];
---

<section class="seccion trabajos" id="trabajos" aria-labelledby="trabajos-titulo">
  <header class="cabecera-chica">
    <p class="paso">{t.etiqueta}</p>
    <h2 id="trabajos-titulo">{t.titulo}</h2>
  </header>

  <div class="pestanas" role="group" aria-label={t.filtros}>
    {
      pestanas.map(([clave, texto], i) => (
        <>
          {i > 0 && <i class="separador" aria-hidden="true" />}
          <button type="button" class="pestana" data-filtro={clave} aria-pressed={i === 0 ? 'true' : 'false'}>
            {texto}
          </button>
        </>
      ))
    }
  </div>

  <div class="filas">
    {
      filas.map((g) => (
        <section class="grupo" data-tipo={g.tipo} aria-label={g.titulo}>
          <header class="grupo-nombre">
            <span class:list={['cuadrito', g.color]} aria-hidden="true">
              <Fragment set:html={svgIcono(g.icono)} />
            </span>
            <span>
              <strong>{g.titulo}</strong>
              <small>{g.detalle}</small>
            </span>
          </header>
          <ul>
            {g.piezas.map((p) => (
              <li class="tarjeta">
                <button type="button" data-grande={p.grande} data-video={p.video} aria-label={p.nombre}>
                  <img src={p.mini} alt="" loading="lazy" decoding="async" />
                  {p.video && (
                    <span class="reproducir" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
                      </svg>
                    </span>
                  )}
                </button>
                <i class="esquina" />
                <i class="esquina" />
                <i class="esquina" />
                <i class="esquina" />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  {/* Visor: muestra la pieza en grande, el video con sus controles y sonido */}
  <dialog class="visor-trabajo" aria-label={t.etiqueta}>
    <button type="button" class="cerrar" aria-label={t.cerrar} title={t.cerrar}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
    <video controls playsinline preload="none" hidden></video>
    <img alt="" hidden />
  </dialog>
</section>

<script>
  // Pestañas que muestran solo las filas de un tipo (en cascada con saltito) y un visor para ver cada pieza
  import { salto } from '../scripts/escena';

  document.addEventListener('astro:page-load', () => {
    const seccion = document.querySelector<HTMLElement>('.trabajos');
    if (!seccion) return;
    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pestanas = [...seccion.querySelectorAll<HTMLButtonElement>('.pestana')];
    const grupos = [...seccion.querySelectorAll<HTMLElement>('.grupo')];
    let relojes: number[] = [];

    const filtrar = (filtro: string) => {
      relojes.forEach(clearTimeout);
      relojes = [];
      pestanas.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === filtro)));
      const visibles = grupos.filter((g) => filtro === 'todo' || g.dataset.tipo === filtro);
      grupos.forEach((g) => (g.hidden = !visibles.includes(g)));
      if (reducir) return;
      // Cada tarjeta aparece un instante después que la anterior, fila por fila, con corte seco
      visibles
        .flatMap((g) => [...g.querySelectorAll<HTMLElement>('.tarjeta')])
        .forEach((c, i) => {
          c.classList.add('oculta');
          relojes.push(
            window.setTimeout(() => {
              c.classList.remove('oculta');
              salto(c);
            }, 60 + i * 45),
          );
        });
    };
    pestanas.forEach((b) => b.addEventListener('click', () => filtrar(b.dataset.filtro!)));

    // Visor
    const visor = seccion.querySelector<HTMLDialogElement>('.visor-trabajo')!;
    const video = visor.querySelector('video')!;
    const imagen = visor.querySelector('img')!;
    seccion.querySelectorAll<HTMLButtonElement>('.tarjeta button').forEach((boton) =>
      boton.addEventListener('click', () => {
        const { video: src, grande } = boton.dataset;
        video.hidden = !src;
        imagen.hidden = !!src;
        if (src) {
          video.poster = grande!;
          video.src = src;
          video.play().catch(() => {});
        } else {
          imagen.src = grande!;
          imagen.alt = boton.getAttribute('aria-label') ?? '';
        }
        visor.showModal();
      }),
    );
    const cerrar = () => visor.close();
    visor.querySelector('.cerrar')!.addEventListener('click', cerrar);
    visor.addEventListener('click', (e) => e.target === visor && cerrar());
    visor.addEventListener('close', () => {
      video.pause();
      video.removeAttribute('src');
      video.load();
    });
  });
</script>

<style>
  .trabajos {
    text-align: center;
  }

  /* Pestañas separadas por cuadritos, como las del inicio */
  .pestanas {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }

  .pestana {
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: var(--gris);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .pestana[aria-pressed='true'] {
    color: var(--texto);
    font-weight: 600;
  }

  .pestana[aria-pressed='true']::before {
    content: '[';
  }

  .pestana[aria-pressed='true']::after {
    content: ']';
  }

  .pestana:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 3px;
  }

  .separador {
    width: 5px;
    height: 5px;
    background: var(--gris);
  }

  /* Filas: nombre del grupo con su cuadrito a la izquierda y cuatro tarjetas iguales */
  .filas {
    display: grid;
    gap: 2rem;
    max-width: var(--contenido);
    margin: 2rem auto 0;
    text-align: left;
  }

  .grupo {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .grupo[hidden] {
    display: none;
  }

  .grupo-nombre {
    display: grid;
    gap: 0.6rem;
  }

  .grupo-nombre .cuadrito {
    width: 2.75rem;
  }

  .grupo-nombre strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .grupo-nombre small {
    color: var(--gris);
    font-size: 0.8125rem;
  }

  .grupo ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tarjeta {
    position: relative;
  }

  .tarjeta.oculta {
    visibility: hidden;
  }

  .tarjeta button {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 4px;
    background: var(--superficie);
    cursor: pointer;
  }

  .tarjeta button:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 4px;
  }

  .tarjeta img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reproducir {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: var(--negro);
  }

  .reproducir svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  /* Las esquinas de selección solo aparecen al pasar el mouse */
  .tarjeta .esquina {
    visibility: hidden;
  }

  .visor-trabajo {
    max-width: min(92vw, 30rem);
    max-height: 92svh;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 14px;
    background: var(--negro);
  }

  .visor-trabajo::backdrop {
    background: rgb(20 15 10 / 0.6);
    backdrop-filter: blur(6px);
  }

  .visor-trabajo video,
  .visor-trabajo img {
    display: block;
    width: 100%;
    max-height: 88svh;
    border-radius: 14px;
    object-fit: contain;
  }

  .visor-trabajo video {
    aspect-ratio: 9 / 16;
  }

  .visor-trabajo [hidden] {
    display: none;
  }

  .cerrar {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--superficie);
    color: var(--texto);
    cursor: pointer;
  }

  .cerrar svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .tarjeta:hover .esquina {
      visibility: visible;
    }

    .pestana[aria-pressed='false']:hover {
      color: var(--texto);
    }
  }

  /* En celular el nombre del grupo va arriba, en una línea con su cuadrito */
  @media (max-width: 720px) {
    .grupo {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .grupo-nombre {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 0.75rem;
    }

    .grupo-nombre .cuadrito {
      width: 2.25rem;
    }

    .grupo ul {
      gap: 0.75rem;
    }

    .pestanas {
      gap: 0.6rem;
    }

    .pestana {
      font-size: 0.875rem;
    }
  }
</style>
