---
import { servicios } from '../data/servicios.json';
import { posts } from '../data/diseno.json';

import { textosDe, tr, type Idioma } from '../lib/i18n';
import { optimizar } from '../lib/imagenes';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = textosDe(lang).servicios;

// El pase muestra los posts a unos 320 px de lado: 640 px alcanza para pantallas de alta densidad
const pase = await Promise.all(posts.map((p) => optimizar(p.imagenes[0], 640)));
---

<section class="seccion" id="servicios">
  <p class="etiqueta">{t.etiqueta}</p>
  <h2>{t.titulo.antes}{' '}<em>{t.titulo.destacado}</em>{' '}{t.titulo.despues}</h2>
  <p class="subtitulo">{t.subtitulo}</p>

  <ol class="servicios">
    {
      servicios.map((s, i) => (
        <li class="tarjeta">
          <div class="cabecera">
            <span class="numero">0{i + 1}</span>
            <svg
              class="icono"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {s.icono === 'video' && (
                <>
                  <rect x="3" y="5" width="18" height="14" rx="3" />
                  <path d="m10 9 5 3-5 3z" />
                </>
              )}
              {s.icono === 'animacion' && (
                <>
                  <circle cx="5.5" cy="18.5" r="2.5" />
                  <circle cx="18.5" cy="5.5" r="2.5" />
                  <path d="M8 18.5c7 0 1-13 8-13" />
                </>
              )}
              {s.icono === 'diseno' && (
                <>
                  <rect x="3" y="3" width="18" height="18" rx="3" />
                  <circle cx="15.5" cy="8.5" r="1.5" />
                  <path d="m3 16 5-5 4 4 3-3 6 6" />
                </>
              )}
            </svg>
          </div>
          {s.media === 'posts' ? (
            <div class="media pase" role="img" aria-label={t.pase}>
              {pase.map((src, n) => (
                <img data-src={src} alt="" width="640" height="640" decoding="async" class:list={{ activa: n === 0 }} />
              ))}
            </div>
          ) : (
            <div class="media">
              {s.video ? (
                <video data-src={s.video} poster={s.poster || undefined} muted loop playsinline preload="none" />
              ) : (
                <span>{t.proximamente}</span>
              )}
            </div>
          )}
          <h3>{tr(s, 'titulo', lang)}</h3>
          <p>{tr(s, 'texto', lang)}</p>
          <p class="ideal">
            <strong>{t.idealPara}</strong> {tr(s, 'ideal', lang)}
          </p>
        </li>
      ))
    }
  </ol>

  <div class="acciones">
    <a class="boton boton-oscuro" href="#casos">{t.ctaProyectos}</a>
    <a class="boton boton-claro" href="#contacto">{t.ctaCotizar}</a>
  </div>
</section>

<script>
  const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Los videos se descargan y reproducen solo mientras su tarjeta está a la vista
  const observador = new IntersectionObserver(
    (entradas) =>
      entradas.forEach(({ target, isIntersecting }) => {
        const video = target as HTMLVideoElement;
        if (!isIntersecting) return video.pause();
        if (!video.src) video.src = video.dataset.src!;
        if (!reducir) video.play().catch(() => {});
      }),
    { rootMargin: '150px' },
  );
  document.querySelectorAll<HTMLVideoElement>('#servicios video[data-src]').forEach((video) => observador.observe(video));

  // Pase de posts con disolución; cada imagen se descarga justo antes de mostrarse
  document.querySelectorAll<HTMLElement>('#servicios .pase').forEach((pase) => {
    const imagenes = [...pase.querySelectorAll('img')];
    let actual = 0;
    let reloj = 0;
    const cargar = (n: number) => {
      const imagen = imagenes[n % imagenes.length];
      if (!imagen.getAttribute('src')) imagen.src = imagen.dataset.src!;
      return imagen;
    };
    const avanzar = () => {
      const siguiente = cargar(actual + 1);
      if (!siguiente.complete) return;
      imagenes[actual].classList.remove('activa');
      siguiente.classList.add('activa');
      actual = (actual + 1) % imagenes.length;
      cargar(actual + 1);
    };
    new IntersectionObserver(
      ([entrada]) => {
        window.clearInterval(reloj);
        if (!entrada.isIntersecting) return;
        cargar(actual);
        if (reducir) return;
        cargar(actual + 1);
        reloj = window.setInterval(avanzar, 2500);
      },
      { rootMargin: '150px' },
    ).observe(pase);
  });
</script>

<style>
  .subtitulo {
    max-width: 44ch;
    margin-top: 0.75rem;
    color: var(--gris);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
  }

  .servicios {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .tarjeta {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 24px;
    background: var(--superficie);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .numero {
    padding: 0.2rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--acento-texto) 35%, transparent);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--acento-texto);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .icono {
    width: 1.75rem;
    height: 1.75rem;
  }

  /* Espacio cuadrado (1080x1080) para un video corto en loop */
  .media {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    color: var(--gris);
    font-size: 0.875rem;
  }

  .pase {
    position: relative;
  }

  .pase img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .pase img.activa {
    opacity: 1;
  }

  .media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  h3 {
    margin: 1.5rem 0 0.6rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .tarjeta p {
    color: var(--gris);
    font-size: 0.9375rem;
  }

  .tarjeta .ideal {
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 0.875rem;
  }

  .ideal strong {
    color: var(--negro);
    font-weight: 600;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .tarjeta:hover {
      transform: translateY(-4px);
      box-shadow: 0 24px 40px -28px rgb(0 0 0 / 0.35);
    }

    .tarjeta:hover .numero {
      background: var(--acento);
      border-color: var(--acento);
      color: var(--negro);
    }
  }

  @media (max-width: 820px) {
    .servicios {
      grid-template-columns: 1fr;
      max-width: 460px;
    }
  }
</style>
