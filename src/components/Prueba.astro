---
import { cifras } from '../data/cifras.json';
import { textosDe, tr, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = textosDe(lang).prueba;
---

<section class="prueba" aria-label={t.etiqueta}>
  <ul>
    {
      cifras.map((c) => {
        // Sin valor se muestra el marcador para completar; no se inventan cifras
        const numero = c.valor === '' || c.valor == null ? t.pendiente : `${c.prefijo}${c.valor}`;
        return (
          <li>
            {/* Mismas tres capas que el nombre del hero: el script de pixeles las rellena con el scroll */}
            <strong class="cifra pixel">
              <canvas class="pixel-lienzo" aria-hidden="true" />
              <span class="pixel-mascara" aria-hidden="true">
                {numero}
              </span>
              <span class="pixel-contorno">{numero}</span>
            </strong>
            <span class="rotulo">{tr(c, 'etiqueta', lang)}</span>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .prueba {
    max-width: var(--ancho);
    margin: 0 auto;
    padding: 0 1.5rem clamp(2rem, 4vw, 3rem);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--linea);
    text-align: center;
  }

  li {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
  }

  .cifra {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* Sin animación el número es texto negro normal; con ella queda en contorno y se rellena */
  .cifra :global(.pixel-contorno) {
    color: var(--texto);
  }

  .cifra:global(.activo) :global(.pixel-contorno) {
    color: transparent;
    -webkit-text-stroke: 1px var(--contorno);
  }

  .rotulo {
    color: var(--gris);
    font-size: clamp(0.8125rem, 1.4vw, 1rem);
  }
</style>
