---
import Redes from './Redes.astro';
import { enlaceWhatsapp, iconoWhatsapp } from '../lib/enlaces';
import { textosDe, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = textosDe(lang).contacto;
---

<section class="contacto" id="contacto">
  <p class="etiqueta">{t.etiqueta}</p>
  <h2>{t.titulo.antes}{' '}<em>{t.titulo.destacado}</em>{t.titulo.cierre}</h2>
  <p class="texto">{t.texto}</p>
  <a class="boton boton-whatsapp" href={enlaceWhatsapp(lang)} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconoWhatsapp} fill="currentColor"></path></svg>
    {t.cta}
  </a>
  <div class="seguir">
    <span>{t.redes}</span>
    <Redes oscuro />
  </div>
</section>

<style>
  .contacto {
    max-width: calc(var(--ancho) - 3rem);
    margin: 0 1.5rem;
    padding: clamp(4rem, 8vw, 6.5rem) 1.5rem;
    border-radius: 32px;
    background: var(--negro);
    color: #fff;
    text-align: center;
  }

  @media (min-width: 1228px) {
    .contacto {
      margin-inline: auto;
    }
  }

  /* Sobre negro el naranja claro ya tiene contraste de sobra */
  .etiqueta {
    color: var(--acento-suave);
  }

  h2 {
    max-width: 17ch;
    margin-inline: auto;
    font-size: clamp(2.25rem, 6.4vw, 5.25rem);
  }

  .texto {
    margin: 1.25rem auto 2rem;
    color: rgb(255 255 255 / 0.7);
  }

  .boton-whatsapp {
    padding: 1.15rem 2.1rem;
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    font-weight: 600;
  }

  .seguir {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.7);
  }
</style>
