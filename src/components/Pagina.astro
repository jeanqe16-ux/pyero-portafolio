---
import { getCollection } from 'astro:content';
import { ui, type Idioma } from '../i18n/ui';
import sitio from '../data/sitio.json';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = ui[lang];
const en = lang === 'en';
const otroIdioma = en ? '/' : '/en/';

const proyectos = (await getCollection('proyectos'))
  .sort((a, b) => a.data.orden - b.data.orden)
  .map(({ data }) => ({
    ...data,
    titulo: (en && data.titulo_en) || data.titulo,
    categoria: (en && data.categoria_en) || data.categoria,
    descripcion: (en && data.descripcion_en) || data.descripcion,
  }));

// Abanico: cada reel rota y baja según su distancia al centro
const centro = (proyectos.length - 1) / 2;
const abanico = (i: number) => `--r:${(i - centro) * 4}deg;--y:${Math.abs(i - centro) * 14}px`;

// La franja se repite para que el loop no deje huecos
const franja = Array.from({ length: 4 }, () => proyectos).flat();

const mensaje = en ? sitio.mensaje_whatsapp_en : sitio.mensaje_whatsapp;
const whatsapp = `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(mensaje)}`;

const iconoWhatsapp =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z';
const iconoTiktok =
  'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.titulo}</title>
    <meta name="description" content={t.meta.descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Silkscreen:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <a class="marca" href={en ? '/en/' : '/'}>Pyero<span>.workz</span></a>
      <nav class="nav-links">
        <a href="#servicios">{t.nav.servicios}</a>
        <a href="#sobre-mi">{t.nav.sobre}</a>
        <a href="#contacto">{t.nav.contacto}</a>
      </nav>
      <div class="nav-acciones">
        <a class="idioma" href={otroIdioma} aria-label={t.idioma}>
          <span class:list={{ activo: !en }}>ES</span>
          <span class:list={{ activo: en }}>EN</span>
        </a>
        <a class="boton boton-oscuro boton-chico" href={whatsapp} target="_blank" rel="noopener">{t.nav.cta}</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <p class="estado"><i></i>{t.hero.estado}</p>
        <h1>
          {t.hero.titulo[0]}
          <span class="chip" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
          </span>
          <em>{t.hero.titulo[1]}</em><br />
          {t.hero.titulo[2]}
          <span class="chip chip-claro" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" fill="currentColor"></path>
            </svg>
          </span>
          <em>{t.hero.titulo[3]}</em>
        </h1>
        <p class="bajada">{t.hero.bajada}</p>
        <div class="acciones">
          <a class="boton boton-oscuro" href={whatsapp} target="_blank" rel="noopener">{t.hero.cta}</a>
          <a class="boton boton-claro" href="#servicios">{t.hero.secundario}</a>
        </div>

        <div class="escenario">
          <p class="bit" aria-hidden="true">Pyero.workz</p>
          <ul class="reels">
            {
              proyectos.map((p, i) => (
                <li class="reel" style={abanico(i)} tabindex="0">
                  {p.video ? (
                    <video src={p.video} poster={p.poster || undefined} muted loop playsinline preload="metadata" />
                  ) : p.poster ? (
                    <img src={p.poster} alt={p.titulo} loading="lazy" />
                  ) : (
                    <div class="reel-vacio">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                      </svg>
                      <span>{t.hero.proximamente}</span>
                    </div>
                  )}
                  <div class="reel-pie">
                    <strong>{p.cliente}</strong>
                    <span>{p.categoria}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="franja" aria-label={t.marquee}>
        <div class="franja-pista">
          {
            [0, 1].map((mitad) => (
              <ul aria-hidden={mitad === 1 ? 'true' : undefined}>
                {franja.map((p) => (
                  <li>
                    {p.logo ? <img src={p.logo} alt={p.cliente} loading="lazy" /> : <span>{p.usuario || p.cliente}</span>}
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </section>

      <section class="seccion" id="servicios">
        <p class="etiqueta">{t.servicios.etiqueta}</p>
        <h2>
          {t.servicios.titulo[0]} <em>{t.servicios.titulo[1]}</em>
          {t.servicios.titulo[2]}
        </h2>
        <ol class="servicios">
          {
            t.servicios.lista.map((s, i) => (
              <li>
                <span class="numero">0{i + 1}</span>
                <h3>{s.titulo}</h3>
                <p>{s.texto}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="seccion sobre" id="sobre-mi">
        <div class="foto">
          {sitio.foto ? <img src={sitio.foto} alt="Pyero" loading="lazy" /> : <span>{t.sobre.foto}</span>}
        </div>
        <div>
          <p class="etiqueta">{t.sobre.etiqueta}</p>
          <h2>
            {t.sobre.titulo[0]} <em>{t.sobre.titulo[1]}</em>
            {t.sobre.titulo[2]}
          </h2>
          {t.sobre.parrafos.map((p) => <p class="texto">{p}</p>)}
          <p class="etiqueta herramientas-titulo">{t.sobre.herramientas}</p>
          <ul class="herramientas">
            {sitio.herramientas.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      </section>

      <section class="contacto" id="contacto">
        <p class="etiqueta">{t.contacto.etiqueta}</p>
        <h2>
          {t.contacto.titulo[0]} <em>{t.contacto.titulo[1]}</em>
          {t.contacto.titulo[2]}
        </h2>
        <p class="texto">{t.contacto.texto}</p>
        <a class="boton boton-whatsapp" href={whatsapp} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconoWhatsapp} fill="currentColor"></path></svg>
          {t.contacto.cta}
        </a>
        <div class="redes">
          <span>{t.contacto.redes}</span>
          <a class="red instagram" href={sitio.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
              <defs>
                <linearGradient id="ig" x1="0" y1="1" x2="1" y2="0">
                  <stop offset="0" stop-color="#FEDA75"></stop>
                  <stop offset=".3" stop-color="#FA7E1E"></stop>
                  <stop offset=".6" stop-color="#D62976"></stop>
                  <stop offset=".85" stop-color="#962FBF"></stop>
                  <stop offset="1" stop-color="#4F5BD5"></stop>
                </linearGradient>
              </defs>
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
              <circle cx="12" cy="12" r="4.3"></circle>
              <path d="M17.4 6.6h.01"></path>
            </svg>
          </a>
          <a class="red tiktok" href={sitio.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24"><path d={iconoTiktok} fill="currentColor"></path></svg>
          </a>
        </div>
      </section>
    </main>

    <footer class="pie">
      <span>© {new Date().getFullYear()} Pyero.workz</span>
      <span>{t.pie}</span>
    </footer>

    <a class="flotante" href={whatsapp} target="_blank" rel="noopener" aria-label={t.whatsapp} title={t.whatsapp}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconoWhatsapp} fill="currentColor"></path></svg>
    </a>

    <script>
      // Los reels se reproducen al pasar el mouse (o al tocarlos / enfocarlos) y se detienen al salir
      document.querySelectorAll<HTMLElement>('.reel').forEach((reel) => {
        const video = reel.querySelector('video');
        if (!video) return;
        const reproducir = () => video.play().catch(() => {});
        const detener = () => video.pause();
        reel.addEventListener('pointerenter', reproducir);
        reel.addEventListener('pointerleave', detener);
        reel.addEventListener('focus', reproducir);
        reel.addEventListener('blur', detener);
      });
    </script>

    <style is:global>
      :root {
        --acento: #fb8e1f;
        --acento-suave: #fdaf50;
        --negro: #0a0a0a;
        --gris: #6b6b6b;
        --linea: #ececec;
        --superficie: #f5f5f4;
        --ancho: 1180px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: #fff;
        color: var(--negro);
        font-family: 'Helvetica Neue', Helvetica, 'Google Sans', Montserrat, Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      ul,
      ol {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      h1,
      h2 {
        font-weight: 500;
        letter-spacing: -0.045em;
        line-height: 1.04;
        text-wrap: balance;
      }

      h1 {
        font-size: clamp(2.5rem, 6.4vw, 5.25rem);
      }

      h2 {
        font-size: clamp(2rem, 4.4vw, 3.5rem);
      }

      h1 em,
      h2 em {
        font-style: normal;
        color: var(--acento);
      }

      .etiqueta {
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--acento-suave);
        margin-bottom: 1rem;
      }

      .texto {
        color: var(--gris);
        font-size: 1.0625rem;
        max-width: 56ch;
      }

      /* Botones */
      .boton {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.9rem 1.5rem;
        border-radius: 999px;
        font-size: 0.9375rem;
        font-weight: 500;
        border: 1px solid transparent;
        transition:
          transform 0.25s ease,
          background 0.25s ease,
          box-shadow 0.25s ease;
      }

      .boton:hover {
        transform: translateY(-2px);
      }

      .boton svg {
        width: 1.2em;
        height: 1.2em;
      }

      .boton-chico {
        padding: 0.6rem 1.1rem;
        font-size: 0.875rem;
      }

      .boton-oscuro {
        background: var(--negro);
        color: #fff;
        box-shadow: 0 8px 20px -10px rgb(0 0 0 / 0.6);
      }

      .boton-oscuro:hover {
        background: var(--acento);
      }

      .boton-claro {
        border-color: var(--linea);
        background: #fff;
      }

      .boton-claro:hover {
        border-color: var(--negro);
      }

      .boton-whatsapp {
        background: #25d366;
        color: #fff;
      }

      .boton-whatsapp:hover {
        box-shadow: 0 12px 30px -10px #25d366;
      }

      /* Navegación */
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: var(--ancho);
        margin: 0 auto;
        padding: 1rem 1.5rem;
        background: rgb(255 255 255 / 0.82);
        backdrop-filter: blur(14px);
      }

      .marca {
        font-size: 1.125rem;
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      .marca span {
        color: var(--acento);
      }

      .nav-links {
        display: flex;
        gap: 2rem;
        font-size: 0.9375rem;
        color: var(--gris);
      }

      .nav-links a:hover {
        color: var(--negro);
      }

      .nav-acciones {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .idioma {
        display: flex;
        padding: 3px;
        border-radius: 999px;
        background: var(--superficie);
        font-size: 0.75rem;
        font-weight: 600;
      }

      .idioma span {
        padding: 0.35rem 0.6rem;
        border-radius: 999px;
        color: var(--gris);
      }

      .idioma .activo {
        background: var(--negro);
        color: #fff;
      }

      /* Inicio */
      .hero {
        padding: clamp(2.5rem, 6vw, 5rem) 1.5rem 0;
        text-align: center;
      }

      .estado {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--acento-suave);
      }

      .estado i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 4px rgb(34 197 94 / 0.18);
      }

      .chip {
        display: inline-grid;
        place-items: center;
        width: 1.25em;
        height: 0.82em;
        margin: 0 0.06em;
        border-radius: 0.24em;
        background: var(--negro);
        color: #fff;
        vertical-align: 0.02em;
        box-shadow: 0 0.12em 0.3em -0.08em rgb(0 0 0 / 0.5);
        transform: rotate(-4deg);
      }

      .chip-claro {
        background: var(--acento);
        transform: rotate(4deg);
      }

      .chip svg {
        width: 0.5em;
        height: 0.5em;
      }

      .bajada {
        max-width: 54ch;
        margin: 1.5rem auto 0;
        color: var(--gris);
        font-size: 1.0625rem;
      }

      .acciones {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 2rem;
      }

      .escenario {
        position: relative;
        margin-top: clamp(2.5rem, 5vw, 4rem);
        padding: clamp(3rem, 8vw, 7rem) 0 clamp(4rem, 7vw, 6rem);
      }

      .bit {
        position: absolute;
        inset: 0 0 auto;
        font-family: Silkscreen, monospace;
        font-size: clamp(2.6rem, 12.5vw, 11.5rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.06em;
        white-space: nowrap;
        color: transparent;
        -webkit-text-stroke: 1px #d4d4d4;
        user-select: none;
        pointer-events: none;
      }

      .reels {
        position: relative;
        display: flex;
        justify-content: center;
      }

      .reel {
        position: relative;
        flex: none;
        width: clamp(150px, 17vw, 232px);
        aspect-ratio: 9 / 16;
        margin: 0 -0.6vw;
        border-radius: 22px;
        overflow: hidden;
        background: var(--negro);
        cursor: pointer;
        outline: none;
        transform: translateY(var(--y)) rotate(var(--r));
        box-shadow: 0 30px 50px -28px rgb(0 0 0 / 0.55);
        transition:
          transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
          opacity 0.45s ease,
          filter 0.45s ease,
          box-shadow 0.45s ease;
      }

      .reel video,
      .reel img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      /* El reel activo crece y se endereza; los demás se quedan atrás */
      .reel:hover,
      .reel:focus-visible {
        z-index: 5;
        transform: translateY(-12px) rotate(0deg) scale(1.14);
        box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.7);
      }

      .reels:has(.reel:hover) .reel:not(:hover),
      .reels:has(.reel:focus-visible) .reel:not(:focus-visible) {
        opacity: 0.5;
        filter: saturate(0.5) blur(1px);
        transform: translateY(var(--y)) rotate(var(--r)) scale(0.93);
      }

      .reel-vacio {
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 0.75rem;
        height: 100%;
        color: rgb(255 255 255 / 0.55);
        font-size: 0.75rem;
        background: linear-gradient(160deg, #2a2a2a, #0a0a0a 70%);
      }

      .reel:nth-child(even) .reel-vacio {
        background: linear-gradient(160deg, var(--acento-suave), var(--acento) 45%, #7a3a00);
        color: rgb(255 255 255 / 0.85);
      }

      .reel-vacio svg {
        width: 2.5rem;
        height: 2.5rem;
        padding: 0.6rem;
        border-radius: 50%;
        background: rgb(255 255 255 / 0.14);
      }

      .reel-pie {
        position: absolute;
        inset: auto 0 0;
        display: grid;
        gap: 0.1rem;
        padding: 2.5rem 1rem 1rem;
        text-align: left;
        color: #fff;
        font-size: 0.6875rem;
        line-height: 1.3;
        background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
        pointer-events: none;
      }

      .reel-pie strong {
        font-size: 0.8125rem;
        font-weight: 600;
      }

      .reel-pie span {
        opacity: 0.75;
      }

      /* Franja de clientes */
      .franja {
        background: var(--negro);
        color: #fff;
        padding: 1.6rem 0;
        overflow: hidden;
        /* Disolución en los bordes: los logos se desvanecen al salir */
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%, #000 88%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 22%, #000 88%, transparent);
      }

      .franja-pista {
        display: flex;
        width: max-content;
        animation: franja 40s linear infinite;
      }

      .franja:hover .franja-pista {
        animation-play-state: paused;
      }

      .franja ul {
        display: flex;
        align-items: center;
      }

      .franja li {
        display: flex;
        align-items: center;
        padding: 0 2.25rem;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.03em;
        white-space: nowrap;
      }

      .franja img {
        height: 2rem;
        width: auto;
        /* Fuerza cualquier logo a blanco */
        filter: brightness(0) invert(1);
      }

      @keyframes franja {
        to {
          transform: translateX(-50%);
        }
      }

      /* Secciones */
      .seccion {
        max-width: var(--ancho);
        margin: 0 auto;
        padding: clamp(4rem, 9vw, 7.5rem) 1.5rem;
      }

      .servicios {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 3rem;
      }

      .servicios li {
        padding: 2rem;
        border-radius: 24px;
        background: var(--superficie);
        transition:
          background 0.3s ease,
          color 0.3s ease,
          transform 0.3s ease;
      }

      .servicios li:hover {
        background: var(--negro);
        color: #fff;
        transform: translateY(-4px);
      }

      .numero {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--acento-suave);
      }

      .servicios h3 {
        margin: 3.5rem 0 0.75rem;
        font-size: 1.5rem;
        font-weight: 500;
        letter-spacing: -0.035em;
        line-height: 1.15;
      }

      .servicios p {
        color: var(--gris);
        font-size: 0.9375rem;
      }

      .servicios li:hover p {
        color: rgb(255 255 255 / 0.7);
      }

      .sobre {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
        gap: clamp(2rem, 6vw, 5rem);
        align-items: center;
        border-top: 1px solid var(--linea);
      }

      .foto {
        display: grid;
        place-items: center;
        aspect-ratio: 4 / 5;
        border-radius: 28px;
        overflow: hidden;
        background: var(--superficie);
        color: #a3a3a3;
        font-size: 0.875rem;
        transform: rotate(-2deg);
      }

      .foto img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .sobre h2 {
        margin-bottom: 1.5rem;
      }

      .sobre .texto + .texto {
        margin-top: 1rem;
      }

      .herramientas-titulo {
        margin: 2.25rem 0 0.75rem;
      }

      .herramientas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .herramientas li {
        padding: 0.5rem 1rem;
        border: 1px solid var(--linea);
        border-radius: 999px;
        font-size: 0.875rem;
        font-weight: 500;
      }

      /* Contacto */
      .contacto {
        max-width: calc(var(--ancho) - 3rem);
        margin: 0 1.5rem;
        padding: clamp(3rem, 8vw, 6rem) 1.5rem;
        border-radius: 32px;
        background: var(--negro);
        color: #fff;
        text-align: center;
      }

      @media (min-width: 1228px) {
        .contacto {
          margin-inline: auto;
        }
      }

      .contacto .texto {
        margin: 1.25rem auto 2rem;
        color: rgb(255 255 255 / 0.65);
      }

      .redes {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 2.5rem;
        font-size: 0.875rem;
        color: rgb(255 255 255 / 0.65);
      }

      .red {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        border: 1px solid rgb(255 255 255 / 0.18);
        border-radius: 50%;
        color: #fff;
        transition:
          transform 0.25s ease,
          border-color 0.25s ease;
      }

      .red:hover {
        transform: translateY(-3px);
        border-color: rgb(255 255 255 / 0.5);
      }

      .red svg {
        width: 1.35rem;
        height: 1.35rem;
        stroke: currentColor;
        transition: filter 0.25s ease;
      }

      .tiktok svg {
        stroke: none;
      }

      /* Al pasar el mouse cada red recupera sus colores originales */
      .instagram:hover svg {
        stroke: url(#ig);
      }

      .tiktok:hover svg {
        filter: drop-shadow(-1.5px -1.5px 0 #25f4ee) drop-shadow(1.5px 1.5px 0 #fe2c55);
      }

      .pie {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem;
        max-width: var(--ancho);
        margin: 0 auto;
        padding: 2rem 1.5rem 6.5rem;
        font-size: 0.8125rem;
        color: var(--gris);
      }

      /* WhatsApp flotante */
      .flotante {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        z-index: 60;
        display: grid;
        place-items: center;
        width: 3.75rem;
        height: 3.75rem;
        border-radius: 50%;
        background: #25d366;
        color: #fff;
        box-shadow: 0 12px 28px -8px rgb(37 211 102 / 0.75);
        transition: transform 0.25s ease;
      }

      .flotante::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 2px solid #25d366;
        animation: pulso 2.4s ease-out infinite;
      }

      .flotante:hover {
        transform: scale(1.08);
      }

      .flotante svg {
        width: 1.9rem;
        height: 1.9rem;
      }

      @keyframes pulso {
        to {
          transform: scale(1.6);
          opacity: 0;
        }
      }

      @media (max-width: 820px) {
        .nav-links {
          display: none;
        }

        .servicios,
        .sobre {
          grid-template-columns: 1fr;
        }

        .servicios h3 {
          margin-top: 2rem;
        }

        .foto {
          max-width: 360px;
        }

        /* En móvil los reels pasan a un carrusel deslizable */
        .reels {
          justify-content: flex-start;
          gap: 0.75rem;
          margin: 0 -1.5rem;
          padding: 1.5rem;
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          scrollbar-width: none;
        }

        .reel {
          width: 58vw;
          max-width: 260px;
          margin: 0;
          scroll-snap-align: center;
          transform: none;
        }

        .reel:hover,
        .reel:focus-visible {
          transform: scale(1.04);
        }

        .reels:has(.reel:hover) .reel:not(:hover),
        .reels:has(.reel:focus-visible) .reel:not(:focus-visible) {
          transform: scale(0.97);
        }
      }

      @media (max-width: 480px) {
        .nav .boton {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .franja-pista,
        .flotante::before {
          animation: none;
        }

        .reel,
        .boton {
          transition: none;
        }
      }
    </style>
  </body>
</html>
