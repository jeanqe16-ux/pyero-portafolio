---
import { clientes } from '../data/clientes.json';
import { creadores } from '../data/creadores.json';
import { textosDe, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const textos = textosDe(Astro.props.lang);
const t = textos.clientes;
// Cada ficha se tapa con una rejilla de 4x4 celdas que se retiran en un orden fijo, como un mosaico
const CELDAS = 16;
const orden = (semilla: number) => Array.from({ length: CELDAS }, (_, i) => ((i * 7 + semilla * 5) % CELDAS) * 40 + semilla * 90);
---

<section class="seccion clientes" aria-labelledby="clientes-titulo">
  <header class="cabecera-chica">
    <p class="paso">{textos.franja.etiqueta}</p>
    <h2 id="clientes-titulo">{t.titulo}</h2>
  </header>

  <ul class="mosaico">
    {
      clientes.map((c, n) => (
        <li class="ficha cuadrito" style={`--c:${c.color}`}>
          <a href={`#caso-${c.id}`} aria-label={c.nombre}>
            <img class="logo" src={c.logo} alt="" loading="lazy" decoding="async" />
          </a>
          <span class="tapa" aria-hidden="true">
            {orden(n).map((d) => (
              <i style={`--d:${d}ms`} />
            ))}
          </span>
        </li>
      ))
    }
  </ul>

  {/* Creadores: solo texto, repartidos en una línea y separados por cuadritos */}
  <div class="creadores">
    <p class="rotulo">{t.creadores}</p>
    <ul>
      {
        creadores.map((c, i) => (
          <>
            {i > 0 && <li class="separador" aria-hidden="true" />}
            <li>{c.enlace ? <a href={c.enlace} target="_blank" rel="noopener noreferrer">{c.handle}</a> : c.handle}</li>
          </>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Al entrar en pantalla, las celdas que tapan cada ficha se retiran en escalón, como un mosaico
  document.addEventListener('astro:page-load', () => {
    const mosaico = document.querySelector<HTMLElement>('.clientes .mosaico');
    if (!mosaico) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      mosaico.classList.add('revelado');
      return;
    }
    const observador = new IntersectionObserver(
      ([entrada]) => {
        if (!entrada.isIntersecting) return;
        observador.disconnect();
        mosaico.classList.add('revelado');
      },
      { threshold: 0.35 },
    );
    observador.observe(mosaico);
  });
</script>

<style>
  .clientes {
    text-align: center;
  }

  .mosaico {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    max-width: var(--contenido);
    margin: 2rem auto 0;
    padding: 0;
    list-style: none;
  }

  .ficha {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .ficha a {
    position: absolute;
    inset: 0;
  }

  /* Logo en sus colores, sin deformarse (contain), dentro de una caja fija igual para todos */
  .logo {
    position: absolute;
    inset: 26% 18%;
    width: 64%;
    height: 48%;
    object-fit: contain;
    transition: scale 0.25s ease;
  }

  /* Tapa de 4x4 celdas */
  .tapa {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    pointer-events: none;
  }

  .tapa i {
    background: var(--linea);
  }

  .revelado .tapa i {
    visibility: hidden;
    transition: visibility 0s step-end var(--d);
  }

  .ficha a:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: -4px;
  }

  .creadores {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .rotulo {
    color: var(--gris);
    font-size: 0.8125rem;
  }

  .creadores ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem clamp(1.25rem, 4vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 560;
    letter-spacing: -0.02em;
  }

  .creadores .separador {
    width: 5px;
    height: 5px;
    background: var(--gris);
  }

  @media (hover: hover) and (pointer: fine) {
    .ficha a:hover .logo {
      scale: 1.06;
    }
  }

  @media (max-width: 640px) {
    .creadores ul {
      gap: 0.5rem 0.9rem;
      font-size: 0.9375rem;
    }

    .mosaico {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }
</style>
