---
import { textosDe, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const t = textosDe(Astro.props.lang).filosofia;
---

<section class="filosofia" id="filosofia">
  <div class="fijo">
    <p class="etiqueta">{t.etiqueta}</p>
    <h2>{t.titulo.antes}{' '}<em>{t.titulo.destacado}</em>{t.titulo.despues && ` ${t.titulo.despues}`}</h2>
    <p class="frase">{t.frase}</p>
  </div>
</section>

<style>
  .fijo {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.25rem;
    min-height: 70vh;
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .etiqueta {
    margin: 0;
  }

  h2 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 7.5vw, 6.5rem);
  }

  .frase {
    max-width: 30ch;
    color: var(--gris);
    font-size: clamp(1.0625rem, 2vw, 1.5rem);
    line-height: 1.35;
  }

  /* Con las animaciones activas la sección se alarga y el texto queda fijo mientras los pixeles de fondo forman palabras */
  :global(.con-pixeles) .filosofia {
    height: 240vh;
  }

  :global(.con-pixeles) .fijo {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 0;
  }
</style>
