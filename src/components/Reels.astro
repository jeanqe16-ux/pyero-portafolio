---
import site from '../data/site.json';
import Imagen from './Imagen.astro';
import { textosDe, type Idioma } from '../lib/i18n';
import { ANCHOS_REEL, SIZES_REEL, reelsDe } from '../lib/reels';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = textosDe(lang).hero;
const reels = reelsDe(lang);

// Abanico: cada reel rota y baja según su distancia al centro
const centro = (reels.length - 1) / 2;
const abanico = (i: number) => `--r:${(i - centro) * 4}deg;--y:${Math.abs(i - centro) * 14}px`;
---

<section class="escenario" id="reels" aria-label={t.reels}>
  <div class="bit pixel" aria-hidden="true">
    <canvas class="pixel-lienzo"></canvas>
    <p class="pixel-mascara">{site.marca}{site.marcaSufijo}</p>
    <p class="pixel-contorno">{site.marca}{site.marcaSufijo}</p>
  </div>
  <ul class="reels">
    {
      reels.map((r, i) => (
        <li class="reel" style={abanico(i)} tabindex="0">
          {/* La portada es una imagen con srcset; el video va encima y solo se descarga al reproducirse */}
          {r.poster && <Imagen src={r.poster} alt="" anchos={ANCHOS_REEL} sizes={SIZES_REEL} />}
          {r.video && <video src={r.video} aria-label={r.nombre} muted loop playsinline preload="none" />}
          {r.video && (
            <button
              type="button"
              class="sonido"
              aria-pressed="false"
              aria-label={t.sonidoActivar}
              data-activar={t.sonidoActivar}
              data-silenciar={t.sonidoSilenciar}
            >
              <svg class="icono-silencio" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 5 6 9H3v6h3l5 4z" />
                <path d="m22 9-6 6M16 9l6 6" />
              </svg>
              <svg class="icono-sonido" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 5 6 9H3v6h3l5 4z" />
                <path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" />
              </svg>
            </button>
          )}
          {!r.video && !r.poster && (
            <div class="reel-vacio">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
              </svg>
              <span>{t.proximamente}</span>
            </div>
          )}
          <div class="reel-pie">
            <strong>{r.nombre}</strong>
            <span>{r.categoria}</span>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<script>
  // Los reels suenan por defecto. El navegador no deja reproducir con sonido hasta que la persona
  // hace clic, toca o teclea en la página: mientras tanto el reel corre en silencio y su botón lo indica.
  let conSonido = true;

  // Con mouse los reels se reproducen al pasar por encima; en táctil, al tocarlos
  document.addEventListener('astro:page-load', () => {
    const conMouse = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reels = [...document.querySelectorAll<HTMLElement>('.reel')];

    const mostrarEstado = (reel: HTMLElement) => {
      const video = reel.querySelector('video');
      const boton = reel.querySelector<HTMLElement>('.sonido');
      if (!video || !boton) return;
      const suena = !video.muted;
      boton.setAttribute('aria-pressed', String(suena));
      boton.setAttribute('aria-label', (suena ? boton.dataset.silenciar : boton.dataset.activar) ?? '');
    };

    const reproducir = (reel: HTMLElement) => {
      const video = reel.querySelector('video');
      if (!video) return;
      reels.forEach((otro) => otro !== reel && otro.querySelector('video')?.pause());
      video.muted = !conSonido;
      video
        .play()
        .catch(() => {
          // Sin un gesto previo el navegador bloquea el audio: se reproduce en silencio
          if (video.muted) return;
          video.muted = true;
          return video.play();
        })
        .catch(() => {})
        .finally(() => mostrarEstado(reel));
      mostrarEstado(reel);
    };

    reels.forEach((reel) => {
      const video = reel.querySelector('video');
      if (!video) return;
      const detener = () => video.pause();

      reel.querySelector('.sonido')?.addEventListener('click', (evento) => {
        evento.stopPropagation();
        conSonido = video.muted;
        video.muted = !conSonido;
        if (video.paused) reproducir(reel);
        mostrarEstado(reel);
      });

      if (conMouse) {
        reel.addEventListener('pointerenter', () => reproducir(reel));
        reel.addEventListener('pointerleave', detener);
        // Un clic sobre el reel cuenta como gesto: si estaba en silencio, le da sonido
        reel.addEventListener('click', () => {
          if (!video.muted) return;
          conSonido = true;
          reproducir(reel);
        });
      } else {
        reel.addEventListener('click', () => (video.paused ? reproducir(reel) : detener()));
      }
      reel.addEventListener('focusin', () => video.paused && reproducir(reel));
      reel.addEventListener('focusout', (evento) => {
        if (!reel.contains(evento.relatedTarget as Node | null)) detener();
      });
    });
  });
</script>

<style>
  .escenario {
    position: relative;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(3rem, 8vw, 7rem) 1.5rem clamp(3rem, 5vw, 4rem);
  }

  /* Nombre en fuente bit; las capas .pixel (lienzo, máscara y contorno) están en global.css */
  .bit {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    display: block;
    font-family: Silkscreen, monospace;
    font-size: clamp(2rem, 11vw, 10.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    user-select: none;
    pointer-events: none;
  }

  .bit :global(.pixel-contorno) {
    color: transparent;
    -webkit-text-stroke: 1px var(--contorno);
  }

  .reels {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .reel {
    position: relative;
    flex: none;
    width: clamp(150px, 17vw, 232px);
    aspect-ratio: 9 / 16;
    margin: 0 -0.6vw;
    border-radius: 22px;
    overflow: hidden;
    background: var(--negro);
    cursor: pointer;
    transform: translateY(var(--y)) rotate(var(--r));
    box-shadow: 0 30px 50px -28px rgb(0 0 0 / 0.55);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.45s ease,
      filter 0.45s ease,
      box-shadow 0.45s ease;
  }

  .reel video,
  .reel :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reel:focus-visible {
    z-index: 5;
    outline-offset: 4px;
    border-radius: 22px;
  }

  .sonido {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }

  .sonido svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .sonido[aria-pressed='true'] .icono-silencio,
  .sonido[aria-pressed='false'] .icono-sonido {
    display: none;
  }

  .sonido[aria-pressed='true'] {
    background: var(--acento);
    color: var(--negro);
  }

  .reel-vacio {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    height: 100%;
    color: rgb(255 255 255 / 0.7);
    font-size: 0.75rem;
    background: linear-gradient(160deg, #2a2a2a, #0a0a0a 70%);
  }

  .reel:nth-child(even) .reel-vacio {
    background: linear-gradient(160deg, var(--acento-suave), var(--acento) 45%, #7a3a00);
    color: #fff;
  }

  .reel-vacio svg {
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.6rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }

  .reel-pie {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.1rem;
    padding: 2.5rem 1rem 1rem;
    text-align: left;
    color: #fff;
    font-size: 0.6875rem;
    line-height: 1.3;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
    pointer-events: none;
  }

  .reel-pie strong {
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .reel-pie span {
    opacity: 0.8;
  }

  /* El reel activo crece y se endereza; los demás se quedan atrás */
  @media (hover: hover) and (pointer: fine) {
    .reel:hover {
      z-index: 5;
      transform: translateY(-12px) rotate(0deg) scale(1.14);
      box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.7);
    }

    .sonido[aria-pressed='false']:hover {
      background: rgb(0 0 0 / 0.8);
    }

    .reels:has(.reel:hover) .reel:not(:hover) {
      opacity: 0.5;
      filter: saturate(0.5) blur(1px);
      transform: translateY(var(--y)) rotate(var(--r)) scale(0.93);
    }
  }

  /* En pantallas angostas los reels pasan a un carrusel deslizable */
  @media (max-width: 820px) {
    .reels {
      justify-content: flex-start;
      gap: 0.75rem;
      margin: 0 -1.5rem;
      padding: 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .reel {
      width: 58vw;
      max-width: 260px;
      margin: 0;
      scroll-snap-align: center;
      transform: none;
    }
  }
</style>
