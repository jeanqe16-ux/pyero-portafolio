---
import { casos } from '../data/casos.json';
import { clientes } from '../data/clientes.json';
import { posts, portadas } from '../data/diseno.json';
import { textosDe, tr, type Idioma } from '../lib/i18n';
import { optimizar } from '../lib/imagenes';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = textosDe(lang).casos;
const nombreDe = (id: string) => clientes.find((c) => c.id === id)?.nombre ?? id;


// Piezas de cada caso, en orden: sus videos, luego sus posts (todas las láminas) y sus portadas.
// Cada una lleva su miniatura (160 px) y lo que se muestra en grande: el video con su portada, o la imagen a 900 px.
const piezasDe = (caso: (typeof casos)[number]) =>
  Promise.all([
    ...caso.videos.map(async (v) => ({
      tipo: 'video',
      titulo: v.titulo,
      src: v.video,
      portada: await optimizar(v.poster, 640),
      mini: await optimizar(v.poster, 160),
    })),
    ...[
      ...posts.filter((p) => p.cliente === caso.cliente).flatMap((p) => p.imagenes.map((imagen) => ({ imagen, titulo: p.titulo }))),
      ...portadas.filter((p) => p.cliente === caso.cliente).map((p) => ({ imagen: p.imagen, titulo: p.titulo })),
    ].map(async ({ imagen, titulo }) => ({
      tipo: 'imagen',
      titulo,
      src: await optimizar(imagen, 900),
      portada: '',
      mini: await optimizar(imagen, 160),
    })),
  ]);
const lista = await Promise.all(casos.map(async (caso) => ({ caso, piezas: await piezasDe(caso) })));
---

<section class="seccion" id="casos">
  <p class="etiqueta">{t.etiqueta}</p>
  <h2>{t.titulo.antes}{' '}<em>{t.titulo.destacado}</em>{t.titulo.despues && ` ${t.titulo.despues}`}</h2>

  {
    lista.map(({ caso, piezas }, i) => {
      const nombre = nombreDe(caso.cliente);
      const primera = piezas[0];
      return (
        <article class="caso" id={`caso-${caso.cliente}`}>
          <div class="visor">
            <div class="escena">
              <video
                src={primera?.tipo === 'video' ? primera.src : undefined}
                data-poster={primera?.tipo === 'video' ? primera.portada : undefined}
                aria-label={primera?.tipo === 'video' ? `${nombre}: ${primera.titulo}` : undefined}
                hidden={primera?.tipo !== 'video'}
                controls
                playsinline
                preload="none"
              />
              <img
                src={primera?.tipo === 'imagen' ? primera.src : undefined}
                alt={primera?.tipo === 'imagen' ? `${nombre}: ${primera.titulo}` : ''}
                hidden={primera?.tipo !== 'imagen'}
                loading="lazy"
                decoding="async"
              />
            </div>
            {piezas.length > 1 && (
              <ul class="miniaturas" aria-label={`${t.piezas} ${nombre}`}>
                {piezas.map((p, n) => (
                  <li>
                    <button
                      type="button"
                      data-tipo={p.tipo}
                      data-src={p.src}
                      data-poster={p.portada}
                      data-titulo={`${nombre}: ${p.titulo}`}
                      aria-label={`${p.tipo === 'video' ? t.verVideo : t.verImagen} ${p.titulo}`}
                      aria-pressed={n === 0 ? 'true' : 'false'}
                    >
                      <img src={p.mini} alt="" width="160" height="160" loading="lazy" decoding="async" />
                      {p.tipo === 'video' && (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                        </svg>
                      )}
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div class="relato">
            <p class="numero">
              {t.caso} 0{i + 1}
            </p>
            <h3>{nombre}</h3>
            <dl>
              <div>
                <dt>{t.reto}</dt>
                <dd>{tr(caso, 'reto', lang)}</dd>
              </div>
              <div>
                <dt>{t.hice}</dt>
                <dd>{tr(caso, 'hice', lang)}</dd>
              </div>
              <div class="resultado">
                <dt>{t.resultado}</dt>
                <dd>{tr(caso, 'resultado', lang)}</dd>
              </div>
            </dl>
          </div>
        </article>
      );
    })
  }
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    // La portada de cada video se descarga recién cuando su caso se acerca a la pantalla
    const cercanos = new IntersectionObserver(
      (entradas) =>
        entradas.forEach(({ target, isIntersecting }) => {
          if (!isIntersecting) return;
          const video = target as HTMLVideoElement;
          if (!video.poster) video.poster = video.dataset.poster!;
          cercanos.unobserve(video);
        }),
      { rootMargin: '600px' },
    );
    document.querySelectorAll<HTMLVideoElement>('.escena video[data-poster]').forEach((video) => cercanos.observe(video));

    // Cada miniatura pone su video o su imagen en el espacio principal del caso
    document.querySelectorAll<HTMLElement>('.visor').forEach((visor) => {
      const video = visor.querySelector('video')!;
      const imagen = visor.querySelector<HTMLImageElement>('.escena img')!;
      const botones = [...visor.querySelectorAll<HTMLElement>('.miniaturas button')];

      botones.forEach((boton) =>
        boton.addEventListener('click', () => {
          const { tipo, src, poster, titulo } = boton.dataset;
          botones.forEach((otro) => otro.setAttribute('aria-pressed', String(otro === boton)));
          video.pause();
          video.hidden = tipo !== 'video';
          imagen.hidden = tipo === 'video';
          if (tipo === 'video') {
            video.poster = poster!;
            video.src = src!;
            video.setAttribute('aria-label', titulo!);
            video.play().catch(() => {});
          } else {
            imagen.src = src!;
            imagen.alt = titulo!;
          }
        }),
      );
    });
  });
</script>

<style>
  .caso {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    scroll-margin-top: 6rem;
  }

  h2 + .caso {
    margin-top: 2rem;
  }

  /* Diseño alternado: en los casos pares el texto va a la izquierda */
  .caso:nth-of-type(even) .visor {
    order: 2;
  }

  .visor {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    padding: clamp(1rem, 2.4vw, 1.75rem);
    border-radius: 28px;
    background: var(--superficie);
  }

  /* Espacio principal: el video o la imagen se ajustan dentro sin recortarse */
  .escena {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    min-width: 0;
  }

  .escena video,
  .escena img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    border-radius: 20px;
    box-shadow: 0 26px 44px -30px rgb(0 0 0 / 0.55);
  }

  .escena video {
    height: 100%;
    aspect-ratio: 9 / 16;
    background: var(--negro);
    object-fit: cover;
  }

  .escena [hidden] {
    display: none;
  }

  /* Miniaturas en columna a la derecha; si son muchas, se desplazan */
  .miniaturas {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    height: 0;
    min-height: 100%;
    padding: 2px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .miniaturas button {
    position: relative;
    display: block;
    width: clamp(3rem, 5vw, 3.75rem);
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 12px;
    overflow: hidden;
    background: var(--negro);
    color: #fff;
    opacity: 0.62;
    cursor: pointer;
    transition:
      opacity 0.25s ease,
      border-color 0.25s ease;
  }

  .miniaturas button[aria-pressed='true'] {
    border-color: var(--acento);
    opacity: 1;
  }

  .miniaturas button:focus-visible {
    outline-offset: 1px;
  }

  .miniaturas img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .miniaturas svg {
    position: absolute;
    inset: 0;
    width: 1.1rem;
    height: 1.1rem;
    margin: auto;
    filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.8));
  }

  .numero {
    margin-bottom: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--acento-texto);
  }

  h3 {
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  dl {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0 0;
  }

  dt {
    margin-bottom: 0.2rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--gris);
  }

  dd {
    margin: 0;
    max-width: 44ch;
    font-size: 1.0625rem;
  }

  .resultado {
    padding: 0.9rem 1.25rem;
    border-left: 3px solid var(--acento);
    border-radius: 0 16px 16px 0;
    background: var(--superficie);
  }

  .resultado dd {
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  @media (hover: hover) and (pointer: fine) {
    .miniaturas button:hover {
      opacity: 1;
    }
  }

  @media (max-width: 820px) {
    .caso {
      grid-template-columns: 1fr;
    }

    /* En celular siempre va primero la prueba y luego el texto */
    .caso:nth-of-type(even) .visor {
      order: 0;
    }

    /* Las miniaturas pasan a una fila deslizable bajo el espacio principal */
    .visor {
      grid-template-columns: minmax(0, 1fr);
    }

    .miniaturas {
      display: flex;
      height: auto;
      min-height: 0;
      overflow: auto hidden;
    }

    .miniaturas li {
      flex: none;
    }

    .miniaturas button {
      width: 3.25rem;
    }
  }
</style>
