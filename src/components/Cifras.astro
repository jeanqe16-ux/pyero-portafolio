---
import { cifras } from '../data/cifras.json';
import { textosDe, tr, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const textos = textosDe(lang);
const t = textos.cifras;
// Alturas de las barras de cada gráfico: suben de izquierda a derecha, solo como dibujo
const barras = [0.28, 0.4, 0.35, 0.55, 0.5, 0.72, 0.66, 0.88];
---

<section class="seccion cifras" aria-labelledby="cifras-titulo">
  <header class="cabecera-chica">
    <p class="paso">{textos.prueba.etiqueta}</p>
    <h2 id="cifras-titulo">{t.titulo}</h2>
  </header>

  {/* Panel tipo tablero de métricas: los números cuentan y las barras suben al entrar en pantalla */}
  <div class="panel tablero-cifras">
    <p class="panel-titulo">{t.panel}</p>
    <dl>
      {
        cifras.map((c) => (
          <div class="metrica">
            <dt>{tr(c, 'etiqueta', lang)}</dt>
            <dd>
              <span class="numero" data-valor={c.valor}>
                {c.prefijo}
                <span class="cuenta">{c.valor || textos.prueba.pendiente}</span>
              </span>
              <span class="grafico" aria-hidden="true">
                {barras.map((h, i) => (
                  <i style={`--h:${h};--i:${i}`} />
                ))}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  // Al entrar en pantalla, cada número cuenta desde cero y las barras suben en escalón
  document.addEventListener('astro:page-load', () => {
    const tablero = document.querySelector<HTMLElement>('.tablero-cifras');
    if (!tablero) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      tablero.classList.add('lleno');
      return;
    }
    const observador = new IntersectionObserver(
      ([entrada]) => {
        if (!entrada.isIntersecting) return;
        observador.disconnect();
        tablero.classList.add('lleno');
        tablero.querySelectorAll<HTMLElement>('.numero').forEach((numero) => {
          const final = Number(numero.dataset.valor);
          const cuenta = numero.querySelector<HTMLElement>('.cuenta')!;
          if (!final) return;
          const pasos = Math.min(final, 12);
          for (let i = 0; i <= pasos; i++) {
            window.setTimeout(() => (cuenta.textContent = String(Math.round((final * i) / pasos))), i * 70);
          }
        });
      },
      { threshold: 0.4 },
    );
    observador.observe(tablero);
  });
</script>

<style>
  .cifras {
    text-align: center;
  }

  .tablero-cifras {
    max-width: 50rem;
    margin: 2rem auto 0;
    padding: 1rem 1.25rem 1.25rem;
    text-align: left;
  }

  .panel-titulo {
    color: var(--gris);
    font-size: 0.75rem;
    font-weight: 600;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0.75rem 0 0;
  }

  .metrica {
    padding: 0.9rem 1rem 1rem;
    border: 1px solid var(--linea);
    border-radius: 10px;
    background: var(--fondo);
  }

  dt {
    color: var(--gris);
    font-size: 0.8125rem;
  }

  dd {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.4rem 0 0;
  }

  .numero {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    font-weight: 560;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .grafico {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 2.25rem;
  }

  .grafico i {
    width: 5px;
    height: calc(var(--h) * 100%);
    border-radius: 2px;
    background: color-mix(in srgb, var(--acento) 70%, var(--superficie));
    transform: scaleY(0);
    transform-origin: bottom;
  }

  .grafico i:last-child {
    background: var(--acento);
  }

  .lleno .grafico i {
    transform: scaleY(1);
    transition: transform 0s step-end calc(var(--i) * 70ms);
  }

  @media (max-width: 640px) {
    dl {
      grid-template-columns: 1fr;
    }
  }
</style>
