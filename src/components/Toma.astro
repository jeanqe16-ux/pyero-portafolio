---
import { textosDe, type Idioma } from '../lib/i18n';
import { optimizar } from '../lib/imagenes';
import { reelsDe } from '../lib/reels';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = textosDe(lang).toma;
// Una toma real a pantalla completa entre secciones, como en los videos de referencia: el primer reel, en silencio
const reel = reelsDe(lang)[0];
const portada = reel?.poster ? await optimizar(reel.poster, 1200) : '';
---

{
  reel && (
    <section class="toma" aria-label={t.descripcion}>
      <img src={portada} alt="" loading="lazy" decoding="async" />
      <video src={reel.video} muted loop playsinline preload="none" aria-hidden="true" />
      <p>{t.frase}</p>
    </section>
  )
}

<script>
  // El video solo se descarga y reproduce mientras la toma está en pantalla
  document.addEventListener('astro:page-load', () => {
    const toma = document.querySelector<HTMLElement>('.toma');
    const video = toma?.querySelector('video');
    if (!toma || !video || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const vista = new IntersectionObserver(([entrada]) => {
      if (entrada.isIntersecting) video.play().then(() => toma.classList.add('en-marcha')).catch(() => {});
      else video.pause();
    });
    vista.observe(toma);
  });
</script>

<style>
  .toma {
    position: relative;
    display: grid;
    align-items: end;
    justify-items: start;
    height: min(72svh, 40rem);
    overflow: hidden;
    background: var(--negro);
    color: #fff;
    text-align: left;
  }

  .toma img,
  .toma video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .toma video {
    visibility: hidden;
  }

  .en-marcha video {
    visibility: visible;
  }

  /* Degradado abajo para que la frase se lea sin tapar los subtítulos del reel */
  .toma::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.75), rgb(0 0 0 / 0.1) 55%, transparent);
  }

  .toma p {
    position: relative;
    z-index: 1;
    max-width: 14ch;
    padding: 0 1.5rem clamp(1.5rem, 5vw, 3rem);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }
</style>
