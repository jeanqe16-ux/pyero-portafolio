---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Prueba from './Prueba.astro';
import Franja from './Franja.astro';
import Casos from './Casos.astro';
import Servicios from './Servicios.astro';
import Proceso from './Proceso.astro';
import Sobre from './Sobre.astro';
import Contacto from './Contacto.astro';
import type { Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
---

<Base lang={lang}>
  <Hero lang={lang} />
  <Prueba lang={lang} />
  <Franja lang={lang} />
  <Casos lang={lang} />
  <Servicios lang={lang} />
  <Proceso lang={lang} />
  <Sobre lang={lang} />
  <Contacto lang={lang} />
</Base>
