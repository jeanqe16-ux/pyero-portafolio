---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Reels from './Reels.astro';
import Prueba from './Prueba.astro';
import Franja from './Franja.astro';
import Casos from './Casos.astro';
import Servicios from './Servicios.astro';
import Proceso from './Proceso.astro';
import Sobre from './Sobre.astro';
import Contacto from './Contacto.astro';
import type { Idioma } from '../lib/i18n';
import { conjunto } from '../lib/imagenes';
import { ANCHOS_HERO, SIZES_HERO } from '../lib/hero';
import site from '../data/site.json';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;

// La foto del hero es el elemento más grande del primer pantallazo: se precarga desde el <head> con el mismo srcset
const precarga = { srcset: await conjunto(site.hero.imagen, ANCHOS_HERO, 'avif'), sizes: SIZES_HERO };
---

<Base lang={lang} precarga={precarga}>
  <Hero lang={lang} />
  <Reels lang={lang} />
  <Prueba lang={lang} />
  <Franja lang={lang} />
  <Casos lang={lang} />
  <Servicios lang={lang} />
  <Proceso lang={lang} />
  <Sobre lang={lang} />
  <Contacto lang={lang} />
</Base>
