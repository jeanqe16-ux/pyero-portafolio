---
import Base from '../layouts/Base.astro';
import Apertura from './Apertura.astro';
import Trabajos from './Trabajos.astro';
import Casos from './Casos.astro';
import Nodos from './Nodos.astro';
import Clientes from './Clientes.astro';
import Sobre from './Sobre.astro';
import Cierre from './Cierre.astro';
import type { Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
---

<Base lang={lang}>
  <Apertura lang={lang} />
  <Trabajos lang={lang} />
  <Casos lang={lang} />
  <Nodos lang={lang} />
  <Clientes lang={lang} />
  <Sobre lang={lang} />
  <Cierre lang={lang} />
</Base>
