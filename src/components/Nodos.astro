---
import { pasos } from '../data/proceso.json';
import { textosDe, tr, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = textosDe(lang).proceso;
const titulo = [t.titulo.antes, t.titulo.destacado, t.titulo.despues].filter(Boolean).join(' ');
const flecha = '<svg viewBox="0 0 16 16"><path d="M1.5 1.2 14 7.3l-5.6 1.5-2.4 5.4z"></path></svg>';
---

<section class="seccion proceso" id="proceso" aria-labelledby="proceso-titulo">
  <header class="cabecera-chica">
    <p class="paso">{t.etiqueta}</p>
    <h2 id="proceso-titulo">{titulo}.</h2>
  </header>

  {/* Lista de pasos en texto grande: se encienden al bajar y el cursor señala el activo, como el árbol de archivos de las referencias */}
  <div class="lineas">
    <ol>
      {
        pasos.map((p, i) => (
          <li class="linea">
            <span class="numero">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{tr(p, 'titulo', lang)}</h3>
              <p>{tr(p, 'texto', lang)}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="cursor-pyero" aria-hidden="true"><Fragment set:html={flecha} /><span>Pyero</span></div>
  </div>
</section>

<script>
  // El paso que cruza el centro de la pantalla queda activo; los anteriores ya quedan encendidos
  document.addEventListener('astro:page-load', () => {
    const bloque = document.querySelector<HTMLElement>('.proceso .lineas');
    if (!bloque) return;
    const lineas = [...bloque.querySelectorAll<HTMLElement>('.linea')];
    const cursor = bloque.querySelector<HTMLElement>('.cursor-pyero')!;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      lineas.forEach((l) => l.classList.add('activa'));
      return;
    }
    const activar = (n: number) => {
      lineas.forEach((l, i) => {
        l.classList.toggle('activa', i <= n);
        l.classList.toggle('actual', i === n);
      });
      const h3 = lineas[n].querySelector('h3')!;
      const b = bloque.getBoundingClientRect();
      const r = h3.getBoundingClientRect();
      cursor.style.transform = `translate(${r.right - b.left + 10}px, ${r.top - b.top + r.height * 0.3}px)`;
      cursor.classList.add('visible');
    };
    const observador = new IntersectionObserver(
      (entradas) => entradas.forEach((e) => e.isIntersecting && activar(lineas.indexOf(e.target as HTMLElement))),
      { rootMargin: '-42% 0px -42% 0px' },
    );
    lineas.forEach((l) => observador.observe(l));
  });
</script>

<style>
  .proceso {
    text-align: center;
  }

  .lineas {
    position: relative;
    max-width: 44rem;
    margin: 2.5rem auto 0;
    text-align: left;
  }

  ol {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .linea {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    color: var(--gris);
    opacity: 0.45;
    transition: opacity 0.3s step-end;
  }

  .linea.activa {
    color: var(--texto);
    opacity: 1;
  }

  .numero {
    color: var(--acento-texto);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  h3 {
    display: inline;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .linea p {
    max-width: 48ch;
    margin-top: 0.5rem;
    color: var(--gris);
    font-size: 0.9375rem;
    line-height: 1.5;
    visibility: hidden;
  }

  /* Solo el paso actual muestra su explicación; los demás quedan como índice */
  .linea.actual p {
    visibility: visible;
    animation: salto 0.3s step-end;
  }

  .lineas .cursor-pyero {
    opacity: 0;
    transition:
      transform 0.6s cubic-bezier(0.65, 0, 0.25, 1),
      opacity 0.3s ease;
  }

  .lineas .cursor-pyero.visible {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .linea {
      grid-template-columns: 2.25rem minmax(0, 1fr);
    }

    .lineas .cursor-pyero {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .linea p {
      visibility: visible;
    }

    .lineas .cursor-pyero {
      display: none;
    }
  }
</style>
