---
import site from '../data/site.json';
import { iconoTiktok } from '../lib/enlaces';

interface Props {
  oscuro?: boolean;
}

const { oscuro = false } = Astro.props;
---

<div class:list={['redes', { oscuro }]}>
  <a class="red instagram" href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
      <circle cx="12" cy="12" r="4.3"></circle>
      <path d="M17.4 6.6h.01"></path>
    </svg>
  </a>
  <a class="red tiktok" href={site.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconoTiktok} fill="currentColor"></path></svg>
  </a>
</div>

<style>
  .redes {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--texto);
  }

  .redes.oscuro {
    color: #fff;
  }

  .red {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 50%;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  .red svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: filter 0.25s ease;
  }

  .instagram svg {
    stroke: currentColor;
  }

  /* Al pasar el mouse cada red recupera sus colores originales */
  @media (hover: hover) and (pointer: fine) {
    .red:hover {
      transform: translateY(-3px);
      border-color: color-mix(in srgb, currentColor 50%, transparent);
    }

    .instagram:hover svg {
      stroke: url(#gradiente-instagram);
    }

    .tiktok:hover svg {
      filter: drop-shadow(-1.5px -1.5px 0 #25f4ee) drop-shadow(1.5px 1.5px 0 #fe2c55);
    }
  }
</style>
