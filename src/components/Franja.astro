---
import textos from '../data/textos.json';
import { clientes } from '../data/clientes.json';
import { proyectos } from '../data/proyectos.json';
import { creadores } from '../data/creadores.json';

// Un cliente enlaza a su página de proyecto solo si existe una con el mismo slug
const nombres = [
  ...clientes.map((c) => ({
    nombre: c.nombre,
    logo: c.logo,
    enlace: proyectos.some((p) => p.slug === c.id) ? `/proyectos/${c.id}/` : '',
    externo: false,
  })),
  ...creadores.map((c) => ({ nombre: c.handle, logo: '', enlace: c.enlace, externo: true })),
];

// La lista se repite para que el loop no deje huecos en pantallas anchas
const franja = Array.from({ length: 3 }, () => nombres).flat();
---

<section class="franja" aria-label={textos.franja.etiqueta}>
  <div class="franja-pista">
    {
      [0, 1].map((mitad) => (
        <ul aria-hidden={mitad === 1 ? 'true' : undefined}>
          {franja.map((n) => {
            const contenido = n.logo ? <img src={n.logo} alt={n.nombre} loading="lazy" /> : <span>{n.nombre}</span>;
            return (
              <li>
                {n.enlace ? (
                  <a
                    href={n.enlace}
                    tabindex={mitad === 1 ? -1 : undefined}
                    target={n.externo ? '_blank' : undefined}
                    rel={n.externo ? 'noopener noreferrer' : undefined}
                  >
                    {contenido}
                  </a>
                ) : (
                  contenido
                )}
              </li>
            );
          })}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .franja {
    background: var(--negro);
    color: #fff;
    padding: 1.5rem 0;
    overflow: hidden;
    /* Disolución en los bordes: los logos se desvanecen al salir */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 22%, #000 88%, transparent);
  }

  .franja-pista {
    display: flex;
    width: max-content;
    animation: franja 60s linear infinite;
  }

  .franja ul {
    display: flex;
    align-items: center;
  }

  .franja li {
    display: flex;
    align-items: center;
    padding: 0 clamp(1.5rem, 3vw, 2.5rem);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .franja a {
    display: flex;
  }

  .franja img {
    display: block;
    height: clamp(2.75rem, 5vw, 3.5rem);
    width: auto;
    /* Fuerza cualquier logo a blanco */
    filter: brightness(0) invert(1);
  }

  @keyframes franja {
    to {
      transform: translateX(-50%);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .franja:hover .franja-pista {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .franja-pista {
      animation: none;
    }
  }
</style>
