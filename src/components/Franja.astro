---
import { clientes } from '../data/clientes.json';
import { casos } from '../data/casos.json';
import { creadores } from '../data/creadores.json';
import { textosDe, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;

// Un cliente enlaza a su caso de estudio si tiene uno
const nombres = [
  ...clientes.map((c) => ({
    nombre: c.nombre,
    logo: c.logo,
    enlace: casos.some((caso) => caso.cliente === c.id) ? `#caso-${c.id}` : '',
    externo: false,
  })),
  ...creadores.map((c) => ({ nombre: c.handle, logo: '', enlace: c.enlace, externo: true })),
];

// La lista se repite para que el loop no deje huecos en pantallas anchas
const franja = Array.from({ length: 3 }, () => nombres).flat();
---

<section class="franja" aria-label={textosDe(lang).franja.etiqueta}>
  <div class="franja-pista">
    {
      [0, 1].map((mitad) => (
        <ul aria-hidden={mitad === 1 ? 'true' : undefined}>
          {franja.map((n) => {
            const contenido = n.logo ? (
              <span class="logo" style={`--logo:url('${n.logo}')`}>
                <img src={n.logo} alt={n.nombre} loading="lazy" />
              </span>
            ) : (
              <span class="nombre">{n.nombre}</span>
            );
            return (
              <li>
                {n.enlace ? (
                  <a
                    href={n.enlace}
                    tabindex={mitad === 1 ? -1 : undefined}
                    target={n.externo ? '_blank' : undefined}
                    rel={n.externo ? 'noopener noreferrer' : undefined}
                  >
                    {contenido}
                  </a>
                ) : (
                  contenido
                )}
              </li>
            );
          })}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .franja {
    background: var(--negro);
    color: #fff;
    padding: 1.5rem 0;
    overflow: hidden;
    /* Disolución en los bordes: los logos se desvanecen al salir */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 22%, #000 88%, transparent);
  }

  .franja-pista {
    display: flex;
    width: max-content;
    animation: franja 60s linear infinite;
  }

  .franja ul {
    display: flex;
    align-items: center;
  }

  .franja li {
    display: flex;
    align-items: center;
    padding: 0 clamp(1.5rem, 3vw, 2.5rem);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .franja a {
    display: flex;
  }

  /* El logo se pinta con una máscara para poder teñirlo; la imagen solo aporta el tamaño y el texto alternativo */
  .logo {
    display: block;
    background-color: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  .logo img {
    display: block;
    height: clamp(2.75rem, 5vw, 3.5rem);
    width: auto;
    opacity: 0;
  }

  .franja li {
    filter: drop-shadow(0 0 0 transparent);
    transition:
      color 0.3s ease,
      filter 0.3s ease;
  }

  @keyframes franja {
    to {
      transform: translateX(-50%);
    }
  }

  /* Al pasar el mouse el logo se tiñe de naranja con un resplandor leve; el loop nunca se detiene */
  @media (hover: hover) and (pointer: fine) {
    .franja li:hover {
      color: var(--acento);
      filter: drop-shadow(0 0 14px rgb(251 142 31 / 0.45));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .franja-pista {
      animation: none;
    }
  }
</style>
