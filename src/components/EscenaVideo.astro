---
import { textosDe, type Idioma } from '../lib/i18n';
import { optimizar } from '../lib/imagenes';
import { reelsDe } from '../lib/reels';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = textosDe(lang).escenaVideo;

// Tres de tus reels reales son los clips; el monitor muestra el que está bajo el cabezal
const clips = await Promise.all(
  reelsDe(lang)
    .filter((r) => r.poster)
    .slice(0, 3)
    .map(async (r) => ({ monitor: await optimizar(r.poster, 520), miniatura: await optimizar(r.poster, 120) })),
);
const anchos = [30, 40, 30];
const flecha = '<svg viewBox="0 0 16 16"><path d="M1.5 1.2 14 7.3l-5.6 1.5-2.4 5.4z"></path></svg>';
---

<section class="escena-scroll escena-video" id="edicion" aria-labelledby="escena-video-titulo">
  <div class="escena-fija">
    <div class="orbe-fondo" aria-hidden="true"></div>
    <header class="cabecera-chica">
      <p class="paso">{t.etiqueta}</p>
      <h2 id="escena-video-titulo">{t.titulo}</h2>
    </header>

    <div class="escenario">
      <div class="monitor-envoltura">
        <figure class="monitor" aria-label={t.monitor}>
          {clips.map((c, i) => <img src={c.monitor} alt="" class:list={{ actual: i === 0 }} loading="lazy" decoding="async" />)}
          <figcaption class="subtitulo">{t.subtitulo}</figcaption>
        </figure>

        {/* Panel de color: el cursor de color arrastra el control y el material pasa de lavado a corregido */}
        <div class="panel panel-color" aria-hidden="true">
          <span class="panel-titulo">{t.color}</span>
          <span class="barra"><i class="relleno"></i><i class="perilla"></i></span>
        </div>
      </div>

      <div class="panel linea" aria-hidden="true">
        <div class="linea-cabecera">
          <span class="tiempo">00:00</span>
          <span class="exportar">
            <span class="exportar-texto">{t.exportar}</span>
            <span class="listo-texto">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
              {t.listo}
            </span>
          </span>
        </div>
        <div class="pistas">
          <span class="rotulo">{t.pistas.video}</span>
          <div class="pista video">
            {
              clips.map((c, i) => (
                <span class:list={['clip', { cortable: i === 1 }]} style={`width:${anchos[i]}%;--mini:url('${c.miniatura}')`}>
                  {i === 1 && <span class="mitad" />}
                </span>
              ))
            }
          </div>
          <span class="rotulo">{t.pistas.texto}</span>
          <div class="pista texto">
            <span class="leyenda" style="left:22%;width:20%"></span>
            <span class="leyenda" style="left:50%;width:24%"></span>
          </div>
          <span class="rotulo">{t.pistas.audio}</span>
          <div class="pista audio">
            <span class="hueco"></span>
            <span class="ondas">
              {Array.from({ length: 56 }, (_, i) => <i style={`--h:${(0.3 + Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.45)) * 0.7).toFixed(2)}`} />)}
            </span>
          </div>
          <span class="cabezal"></span>
        </div>
      </div>

      {/* Bloque de música que el cursor de música arrastra hasta la pista */}
      <span class="bloque-musica" aria-hidden="true">{t.musica}</span>

      <div class="cursor-pyero corte" aria-hidden="true"><Fragment set:html={flecha} /><span>{t.cursores.corte}</span></div>
      <div class="cursor-pyero color" aria-hidden="true"><Fragment set:html={flecha} /><span>{t.cursores.color}</span></div>
      <div class="cursor-pyero musica" aria-hidden="true"><Fragment set:html={flecha} /><span>{t.cursores.musica}</span></div>
    </div>
  </div>
</section>

<script>
  // Tres cursores editan según el avance del scroll: corte y subtítulos, color y música
  import { montarEscena, moverCursor, punto, recorrido, salto, suave, tramo } from '../scripts/escena';

  let limpiar: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    limpiar?.();
    limpiar = null;
    const escena = document.querySelector<HTMLElement>('.escena-video');
    if (!escena) return;

    const q = <T extends HTMLElement>(s: string) => escena.querySelector<T>(s)!;
    const escenario = q('.escenario');
    const pista = q('.pista.video');
    const cabezal = q('.cabezal');
    const tiempo = q('.tiempo');
    const corte = q('.cortable');
    const leyenda = q('.leyenda');
    const exportar = q('.exportar');
    const perilla = q('.perilla');
    const barra = q('.barra');
    const relleno = q('.relleno');
    const hueco = q('.hueco');
    const bloque = q('.bloque-musica');
    const imagenes = [...escena.querySelectorAll<HTMLImageElement>('.monitor img')];
    const clips = [...pista.querySelectorAll<HTMLElement>('.clip')];
    const [cCorte, cColor, cMusica] = [q('.cursor-pyero.corte'), q('.cursor-pyero.color'), q('.cursor-pyero.musica')];
    let actual = 0;

    const pintar = (p: number) => {
      const fuera = { x: escenario.clientWidth + 60, y: escenario.clientHeight * 0.9 };

      // Cabezal y monitor: corte seco al clip que está debajo
      const avance = tramo(p, 0.06, 0.86);
      cabezal.style.left = `${pista.offsetLeft + avance * pista.offsetWidth}px`;
      tiempo.textContent = `00:${String(Math.round(avance * 30)).padStart(2, '0')}`;
      const cx = pista.getBoundingClientRect().left + avance * pista.offsetWidth;
      let indice = clips.findIndex((c) => c.getBoundingClientRect().right >= cx);
      if (indice < 0) indice = clips.length - 1;
      if (indice !== actual) {
        imagenes[actual].classList.remove('actual');
        imagenes[indice].classList.add('actual');
        salto(imagenes[indice]);
        actual = indice;
      }

      // Corte: corta el clip del medio, pone los subtítulos y al final exporta
      escena.classList.toggle('cortado', p > 0.22);
      escena.classList.toggle('con-leyenda', p > 0.36);
      escena.classList.toggle('exportado', p > 0.92);
      moverCursor(
        cCorte,
        recorrido(
          p,
          [
            [0.16, 0.24, punto(escenario, corte, 0.46, 0.5)],
            [0.31, 0.38, punto(escenario, leyenda, 0.5, 0.6)],
            [0.84, 0.95, punto(escenario, exportar, 0.5, 0.6)],
          ],
          fuera,
        ),
        (p > 0.2 && p < 0.23) || (p > 0.34 && p < 0.37) || (p > 0.89 && p < 0.92),
      );
      exportar.classList.toggle('pulsado', p > 0.89 && p < 0.92);

      // Color: arrastra el control y el material pasa de lavado a corregido
      const k = suave(tramo(p, 0.44, 0.6));
      relleno.style.width = `${k * 100}%`;
      perilla.style.left = `${k * 100}%`;
      const filtro = `saturate(${0.3 + 0.7 * k}) contrast(${0.86 + 0.14 * k}) brightness(${1.1 - 0.1 * k})`;
      imagenes.forEach((img) => (img.style.filter = filtro));
      const b = barra.getBoundingClientRect();
      const e = escenario.getBoundingClientRect();
      const enPerilla = { x: b.left - e.left + b.width * k, y: b.top - e.top + b.height * 0.5 };
      moverCursor(cColor, recorrido(p, [[0.4, 0.62, enPerilla]], fuera), p > 0.43 && p < 0.61);

      // Música: trae el bloque hasta la pista y aparecen las ondas
      const enHueco = punto(escenario, hueco, 0.08, 0.5);
      const desde = { x: escenario.clientWidth * 0.86, y: escenario.clientHeight * 0.55 };
      const arrastre = suave(tramo(p, 0.64, 0.74));
      let pos = recorrido(p, [[0.64, 0.64, desde]], fuera);
      if (p >= 0.64 && p <= 0.76) pos = { x: desde.x + (enHueco.x - desde.x) * arrastre, y: desde.y + (enHueco.y - desde.y) * arrastre };
      else if (p > 0.76) pos = recorrido(p, [[0.74, 0.76, enHueco]], fuera);
      moverCursor(cMusica, pos, p > 0.63 && p < 0.75);
      bloque.style.transform = `translate(${pos.x - 8}px, ${pos.y - 10}px)`;
      escena.classList.toggle('arrastrando', p > 0.63 && p < 0.75);
      escena.classList.toggle('con-musica', p > 0.75);
    };

    limpiar = montarEscena(escena, pintar);
  });
</script>

<style>
  .escena-video {
    --largo: 190vh;
  }

  .escenario {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    gap: clamp(0.75rem, 2.5svh, 1.5rem);
    min-height: 0;
    margin-top: clamp(0.75rem, 2.5svh, 1.25rem);
  }

  .monitor-envoltura {
    position: relative;
    height: 100%;
    min-height: 0;
    max-height: 28rem;
  }

  /* Monitor vertical de reel */
  .monitor {
    position: relative;
    height: 100%;
    aspect-ratio: 9 / 16;
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
    background: var(--negro);
    box-shadow: 0 30px 60px -36px rgb(40 25 10 / 0.6);
  }

  .monitor img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    visibility: hidden;
  }

  .monitor img.actual {
    visibility: visible;
  }

  .subtitulo {
    position: absolute;
    left: 50%;
    bottom: 16%;
    width: max-content;
    max-width: 86%;
    padding: 0.3rem 0.55rem;
    border-radius: 6px;
    background: var(--superficie);
    color: var(--negro);
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    font-weight: 600;
    text-align: center;
    translate: -50% 0;
    visibility: hidden;
  }

  .con-leyenda .subtitulo {
    visibility: visible;
  }

  /* Panel de color, flotando junto al monitor */
  .panel-color {
    position: absolute;
    left: calc(100% + 1.25rem);
    top: 38%;
    width: 10.5rem;
    padding: 0.65rem 0.8rem 0.8rem;
  }

  .panel-titulo {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--gris);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .barra {
    position: relative;
    display: block;
    height: 4px;
    border-radius: 2px;
    background: var(--linea);
  }

  .relleno {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--orbe-lila), #b39cff);
  }

  .perilla {
    position: absolute;
    top: 50%;
    left: 0;
    width: 14px;
    height: 14px;
    border: 2px solid var(--superficie);
    border-radius: 50%;
    background: #b39cff;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.2);
    translate: -50% -50%;
  }

  /* Línea de tiempo */
  .linea {
    width: min(50rem, 100%);
    padding: 0.7rem 0.9rem 0.85rem;
  }

  .linea-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.55rem;
    font-size: 0.75rem;
  }

  .tiempo {
    color: var(--gris);
    font-variant-numeric: tabular-nums;
  }

  .exportar {
    display: inline-grid;
    justify-items: center;
    padding: 0.28rem 0.7rem;
    border-radius: 8px;
    background: var(--texto);
    color: var(--superficie);
    font-weight: 600;
    transition: scale 0.12s ease;
  }

  .exportar > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .exportar svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .listo-texto,
  .exportado .exportar-texto {
    visibility: hidden;
  }

  .exportado .listo-texto {
    visibility: visible;
  }

  .exportado .exportar {
    background: var(--acento);
    color: var(--negro);
  }

  .exportar.pulsado {
    scale: 0.92;
  }

  .pistas {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.35rem 0.75rem;
  }

  .rotulo {
    color: var(--gris);
    font-size: 0.6875rem;
  }

  .pista {
    position: relative;
    display: flex;
    height: 2.1rem;
  }

  .pista.texto,
  .pista.audio {
    height: 1.3rem;
  }

  .clip {
    position: relative;
    height: 100%;
    border: 1px solid var(--superficie);
    border-radius: 6px;
    background: var(--mini) left center / auto 100% repeat-x;
  }

  .mitad {
    position: absolute;
    top: -2px;
    bottom: -2px;
    left: 46%;
    width: 0;
    background: var(--superficie);
  }

  .cortado .mitad {
    width: 6px;
  }

  .leyenda {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 5px;
    background: color-mix(in srgb, var(--acento) 45%, var(--superficie));
    visibility: hidden;
  }

  .con-leyenda .leyenda {
    visibility: visible;
  }

  /* Música: la pista empieza vacía y se llena cuando el bloque cae en ella */
  .pista.audio {
    align-items: center;
  }

  .hueco {
    position: absolute;
    inset: 0;
    border: 1px dashed color-mix(in srgb, var(--gris) 45%, transparent);
    border-radius: 5px;
  }

  .ondas {
    display: flex;
    align-items: center;
    gap: 2px;
    width: 100%;
    height: 100%;
    visibility: hidden;
  }

  .ondas i {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: 2px;
    background: color-mix(in srgb, #6cc4a8 70%, var(--superficie));
  }

  .con-musica .ondas {
    visibility: visible;
  }

  .con-musica .hueco {
    visibility: hidden;
  }

  .bloque-musica {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: #6cc4a8;
    color: var(--negro);
    font-size: 0.6875rem;
    font-weight: 600;
    white-space: nowrap;
    visibility: hidden;
    pointer-events: none;
  }

  .arrastrando .bloque-musica {
    visibility: visible;
  }

  .cabezal {
    position: absolute;
    top: -0.35rem;
    bottom: -0.25rem;
    left: 0;
    width: 2px;
    background: var(--acento);
    pointer-events: none;
  }

  .cabezal::before {
    content: '';
    position: absolute;
    top: 0;
    left: -5px;
    width: 12px;
    height: 10px;
    border-radius: 2px 2px 6px 6px;
    background: var(--acento);
  }

  /* Sin movimiento: el resultado final, sin cabezal */
  .estatica .monitor-envoltura {
    height: min(56svh, 28rem);
  }

  .estatica .cabezal,
  .estatica .bloque-musica {
    display: none;
  }

  @media (max-width: 900px) {
    /* El panel de color se apoya sobre el borde del monitor */
    .panel-color {
      left: auto;
      right: -4.5rem;
      top: auto;
      bottom: 12%;
      width: 8.5rem;
    }
  }

  @media (max-width: 640px) {
    .linea {
      padding: 0.6rem;
    }

    .pista {
      height: 1.8rem;
    }

    .monitor-envoltura {
      max-height: 20rem;
    }
  }
</style>
