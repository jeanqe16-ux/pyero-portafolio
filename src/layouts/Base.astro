---
import '@fontsource-variable/inter';
import '../styles/global.css';
import site from '../data/site.json';
import { servicios } from '../data/servicios.json';
import Redes from '../components/Redes.astro';
import fuenteInter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { enlaceWhatsapp, iconoWhatsapp } from '../lib/enlaces';
import { ruta, textosDe, tr, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
  titulo?: string;
  descripcion?: string;
}

const { lang } = Astro.props;
const { titulo = tr(site.seo, 'titulo', lang), descripcion = tr(site.seo, 'descripcion', lang) } = Astro.props;
const textos = textosDe(lang);
const inicio = ruta(lang);
const otroIdioma: Idioma = lang === 'es' ? 'en' : 'es';

// Con `site` definido (src/data/site.json > url) todas las URL salen absolutas, como exigen las redes al compartir
const base = Astro.site ?? Astro.url;
const urlPagina = new URL(Astro.url.pathname, base);
const urlDe = (l: Idioma) => new URL(ruta(l), base).href;
const imagen = new URL(tr(site.seo, 'imagen', lang), base).href;
const imagenAlt = tr(site.seo, 'imagenAlt', lang);
const nombre = site.marca + site.marcaSufijo;

// Datos estructurados: servicio profesional con su persona y ubicación
const direccion = {
  '@type': 'PostalAddress',
  addressLocality: site.ubicacion.ciudad,
  addressRegion: site.ubicacion.region,
  addressCountry: site.ubicacion.pais,
};
const redes = [site.instagram, site.tiktok].filter(Boolean);
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#negocio', base).href,
  name: nombre,
  url: urlDe(lang),
  description: descripcion,
  image: imagen,
  logo: new URL('/icon-512.png', base).href,
  telephone: `+${site.whatsapp}`,
  address: direccion,
  sameAs: redes,
  knowsLanguage: ['es', 'en'],
  founder: {
    '@type': 'Person',
    '@id': new URL('/#persona', base).href,
    name: site.persona.nombre,
    alternateName: site.marca,
    jobTitle: tr(site.persona, 'cargo', lang),
    address: direccion,
    sameAs: redes,
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: textos.servicios.etiqueta,
    itemListElement: servicios.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: tr(s, 'titulo', lang), description: tr(s, 'texto', lang) },
    })),
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlPagina} />
    <link rel="alternate" hreflang="es" href={urlDe('es')} />
    <link rel="alternate" hreflang="en" href={urlDe('en')} />
    <link rel="alternate" hreflang="x-default" href={urlDe('es')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_PE'} />
    <meta property="og:site_name" content={nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagenAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagen} />
    <meta name="twitter:image:alt" content={imagenAlt} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <link rel="preload" href={fuenteInter} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
    <script is:inline>
      // Activa la animación de entrada solo si el usuario no pidió menos movimiento
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('animar');
    </script>
  </head>
  <body>
    <canvas class="fondo-pixeles" data-palabras={JSON.stringify(textos.pixeles)} aria-hidden="true"></canvas>

    <svg class="definiciones-svg" aria-hidden="true">
      <defs>
        <linearGradient id="gradiente-instagram" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0" stop-color="#FEDA75"></stop>
          <stop offset=".3" stop-color="#FA7E1E"></stop>
          <stop offset=".6" stop-color="#D62976"></stop>
          <stop offset=".85" stop-color="#962FBF"></stop>
          <stop offset="1" stop-color="#4F5BD5"></stop>
        </linearGradient>
      </defs>
    </svg>

    <header class="nav">
      <div class="nav-interior">
        <a class="marca" href={inicio}>{site.marca}<span>{site.marcaSufijo}</span></a>
        <nav class="nav-links" aria-label="Principal">
          <a href={`${inicio}#casos`}>{textos.nav.casos}</a>
          <a href={`${inicio}#servicios`}>{textos.nav.servicios}</a>
          <a href={`${inicio}#sobre-mi`}>{textos.nav.sobre}</a>
          <a href={`${inicio}#contacto`}>{textos.nav.contacto}</a>
        </nav>
        <div class="nav-acciones">
          <Redes />
          <a class="idioma" href={ruta(otroIdioma)} hreflang={otroIdioma} aria-label={textos.nav.idioma}>
            <span class:list={{ activo: lang === 'es' }}>ES</span>
            <span class:list={{ activo: lang === 'en' }}>EN</span>
          </a>
          <a class="boton boton-oscuro boton-chico" href={`${inicio}#contacto`}>{textos.nav.cta}</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <span>© {new Date().getFullYear()} {nombre}. {textos.pie}</span>
      <Redes />
    </footer>

    <a
      class="flotante"
      href={enlaceWhatsapp(lang)}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={textos.whatsapp}
      title={textos.whatsapp}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconoWhatsapp} fill="currentColor"></path></svg>
    </a>
    <script>
      // Entrada sutil de cada sección al hacer scroll
      if (document.documentElement.classList.contains('animar')) {
        const observador = new IntersectionObserver(
          (entradas) =>
            entradas.forEach((entrada) => {
              if (!entrada.isIntersecting) return;
              entrada.target.classList.add('visible');
              observador.unobserve(entrada.target);
            }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('main > :not(.hero)').forEach((seccion) => observador.observe(seccion));
      }
    </script>
    <script>
      import '../scripts/pixeles';
    </script>
  </body>
</html>
