---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import textos from '../../data/textos.json';
import { proyectos } from '../../data/proyectos.json';

export function getStaticPaths() {
  return proyectos.map((proyecto) => ({ params: { slug: proyecto.slug }, props: { proyecto } }));
}

const { proyecto } = Astro.props;
const t = textos.proyectos;
---

<Base titulo={`${proyecto.nombre} | ${site.marca}${site.marcaSufijo}`} descripcion={proyecto.descripcion}>
  <article class="seccion">
    <a class="volver" href="/#reels">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M19 12H5m6-6-6 6 6 6"></path>
      </svg>
      {t.volver}
    </a>
    <p class="etiqueta">{t.etiquetaPagina}</p>
    <h1>{proyecto.nombre}</h1>
    <p class="texto">{proyecto.descripcion}</p>

    <ul class="videos">
      {
        proyecto.videos.map((v) => (
          <li>
            {v.video ? (
              <video
                src={v.video}
                poster={v.poster || undefined}
                aria-label={v.titulo}
                preload="none"
                loading="lazy"
                controls
                muted
                playsinline
              />
            ) : (
              <span>{t.proximamente}</span>
            )}
          </li>
        ))
      }
    </ul>

    <a class="boton boton-oscuro" href="/#contacto">{t.cotizar}</a>
  </article>
</Base>

<style>
  .seccion {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .volver {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    padding: 0.5rem 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--gris);
  }

  .volver svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  h1 {
    font-size: clamp(2.25rem, 5.4vw, 4.25rem);
    margin-bottom: 1.25rem;
  }

  .videos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 3rem 0;
  }

  .videos li {
    display: grid;
    place-items: center;
    aspect-ratio: 9 / 16;
    border-radius: 22px;
    overflow: hidden;
    background: var(--superficie);
    color: var(--gris);
    font-size: 0.875rem;
  }

  .videos video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: var(--negro);
  }

  @media (hover: hover) and (pointer: fine) {
    .volver:hover {
      color: var(--negro);
    }
  }

  @media (max-width: 600px) {
    .videos {
      grid-template-columns: 1fr;
      max-width: 320px;
      margin-inline: auto;
    }
  }
</style>
